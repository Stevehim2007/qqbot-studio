+"""SQLite sidecar storage for AstrBot's long-term memory.
+
+The store is deliberately independent from AstrBot's conversation database
+(``data_v4.db``):
+
+* memory keeps its own file (default ``data/astrbot_memory.db``), so it can be
+  deleted, backed up or forgotten without touching chat history;
+* it is plain ``sqlite3`` from the standard library (no ORM, no migrations);
+* FTS5 is used when the Python build has it, otherwise a small BM25-ish
+  scorer in Python keeps retrieval working (some distro builds lack FTS5).
+"""
+
+from __future__ import annotations
+
+import math
+import sqlite3
+import struct
+import threading
+import time
+from collections.abc import Iterable
+from dataclasses import replace
+from pathlib import Path
+
+from .text import (
+    MAX_CONTENT_CHARS,
+    contains_secret,
+    fingerprint,
+    is_contradiction,
+    normalise_value,
+    scrub_secrets,
+    similarity,
+    tokenize,
+)
+from .types import Candidate, MemoryRecord
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS astrbot_memory (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    scope_type TEXT NOT NULL,
+    scope_id TEXT NOT NULL,
+    mem_key TEXT NOT NULL,
+    content TEXT NOT NULL,
+    kind TEXT NOT NULL DEFAULT 'fact',
+    importance REAL NOT NULL DEFAULT 0.5,
+    confidence REAL NOT NULL DEFAULT 0.5,
+    hits INTEGER NOT NULL DEFAULT 0,
+    source TEXT NOT NULL DEFAULT 'heuristic',
+    sender_id TEXT NOT NULL DEFAULT '',
+    fingerprint TEXT NOT NULL,
+    created_at REAL NOT NULL,
+    updated_at REAL NOT NULL,
+    last_used_at REAL,
+    expires_at REAL,
+    UNIQUE (scope_type, scope_id, mem_key)
+);
+CREATE INDEX IF NOT EXISTS idx_astrbot_memory_scope
+    ON astrbot_memory (scope_type, scope_id);
+"""
+
+FTS_SCHEMA = """
+CREATE VIRTUAL TABLE IF NOT EXISTS astrbot_memory_fts
+    USING fts5(mem_key, content, tokens, tokenize='unicode61');
+"""
+
+EMBED_SCHEMA = """
+CREATE TABLE IF NOT EXISTS astrbot_memory_embeddings (
+    memory_id INTEGER PRIMARY KEY,
+    model TEXT NOT NULL,
+    dim INTEGER NOT NULL,
+    vector BLOB NOT NULL,
+    updated_at REAL NOT NULL
+);
+CREATE INDEX IF NOT EXISTS idx_astrbot_memory_embeddings_model
+    ON astrbot_memory_embeddings (model);
+"""
+
+DUPLICATE_SIMILARITY = 0.92
+"""Content at least this similar to the stored value is a duplicate (skip)."""
+
+
+class MemoryStore:
+    """Thread-safe SQLite store for long-term memories."""
+
+    def __init__(
+        self,
+        db_path: str | Path,
+        *,
+        enable_fts: bool = True,
+        clock=time.time,
+        max_records_per_scope: int = 500,
+    ) -> None:
+        self.db_path = Path(db_path)
+        self.clock = clock
+        self.max_records_per_scope = max(20, int(max_records_per_scope))
+        self._lock = threading.RLock()
+        self._conn: sqlite3.Connection | None = None
+        self._fts_declared = bool(enable_fts)
+        self.fts_enabled = False
+        self.last_error = ""
+
+    # ------------------------------------------------------------------
+    # connection / schema
+    # ------------------------------------------------------------------
+    def _connect(self) -> sqlite3.Connection:
+        if self._conn is not None:
+            return self._conn
+        self.db_path.parent.mkdir(parents=True, exist_ok=True)
+        conn = sqlite3.connect(str(self.db_path), timeout=5, check_same_thread=False)
+        conn.row_factory = sqlite3.Row
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute("PRAGMA synchronous=NORMAL")
+        conn.execute("PRAGMA busy_timeout=3000")
+        conn.executescript(SCHEMA)
+        self._migrate(conn)
+        try:
+            conn.executescript(EMBED_SCHEMA)
+        except sqlite3.Error as exc:  # pragma: no cover - defensive
+            self.last_error = f"向量表创建失败（语义检索不可用）：{exc}"
+        if self._fts_declared:
+            try:
+                conn.executescript(FTS_SCHEMA)
+                self.fts_enabled = True
+            except sqlite3.Error as exc:
+                # Distro sqlite3 without FTS5: keep working with the fallback.
+                self.last_error = f"FTS5 不可用，使用 BM25 回退：{exc}"
+                self.fts_enabled = False
+        conn.commit()
+        self._conn = conn
+        return conn
+
+    def close(self) -> None:
+        with self._lock:
+            if self._conn is not None:
+                try:
+                    self._conn.close()
+                finally:
+                    self._conn = None
+
+    def _migrate(self, conn: sqlite3.Connection) -> None:
+        """Additive migrations for DBs created by an older patch version.
+
+        The sidecar file is the durable part of memory: a new column or table
+        must never require deleting it.  ``CREATE TABLE IF NOT EXISTS`` takes
+        care of new tables; a pre-existing table only gains columns here.
+        """
+
+        try:
+            columns = {row["name"] for row in conn.execute("PRAGMA table_info(astrbot_memory)")}
+            if "sender_id" not in columns:
+                conn.execute(
+                    "ALTER TABLE astrbot_memory ADD COLUMN sender_id TEXT NOT NULL DEFAULT ''"
+                )
+        except sqlite3.Error as exc:  # pragma: no cover - defensive
+            self.last_error = f"记忆表迁移失败（sender_id 缺失）：{exc}"
+
+    def backup(self, destination: str | Path | None = None) -> str:
+        """Consistent copy of the sidecar DB (SQLite backup API, WAL-safe)."""
+
+        target = Path(destination) if destination else self.db_path.with_suffix(
+            f".{int(self.clock())}.bak"
+        )
+        target.parent.mkdir(parents=True, exist_ok=True)
+        with self._lock:
+            conn = self._connect()
+            copy = sqlite3.connect(str(target))
+            try:
+                conn.backup(copy)
+                copy.commit()
+            finally:
+                copy.close()
+        return str(target)
+
+    # ------------------------------------------------------------------
+    # write path: formation (create / update / skip)
+    # ------------------------------------------------------------------
+    def upsert(self, candidate: Candidate) -> tuple[str, MemoryRecord | None]:
+        """Form a memory: ``created``, ``updated`` or ``skipped``.
+
+        Duplicates are never written twice: the semantic key
+        ``(scope_type, scope_id, mem_key)`` is unique, and a near-identical
+        content or fingerprint inside the same scope is skipped outright.
+        """
+
+        content = scrub_secrets(str(candidate.content or "")).strip()
+        if not content or contains_secret(content):
+            return "skipped", None
+        content = content[:MAX_CONTENT_CHARS]
+        key = normalise_value(scrub_secrets(str(candidate.key or ""))) or fingerprint(content)
+        scope_type = str(candidate.scope_type or "user")
+        scope_id = str(candidate.scope_id or "")
+        if not scope_id:
+            return "skipped", None
+
+        now = float(self.clock())
+        expires_at = now + candidate.ttl_seconds if candidate.ttl_seconds else None
+        fp = fingerprint(content)
+        with self._lock:
+            conn = self._connect()
+            row = conn.execute(
+                "SELECT * FROM astrbot_memory WHERE scope_type=? AND scope_id=? AND mem_key=?",
+                (scope_type, scope_id, key),
+            ).fetchone()
+            if row is not None:
+                if row["fingerprint"] == fp or similarity(row["content"], content) >= DUPLICATE_SIMILARITY:
+                    return "skipped", self._to_record(row)
+                merged_content = content
+                if is_contradiction(row["content"], content):
+                    # The user reversed a preference: the new claim replaces the
+                    # old one but starts at its own confidence instead of
+                    # inheriting the (now stale) accumulated confidence.
+                    merged_confidence = float(candidate.confidence)
+                else:
+                    merged_confidence = min(
+                        1.0, max(row["confidence"], candidate.confidence) + 0.05
+                    )
+                conn.execute(
+                    "UPDATE astrbot_memory SET content=?, kind=?, importance=?, confidence=?,"
+                    " source=?, fingerprint=?, updated_at=?, expires_at=?,"
+                    " sender_id=CASE WHEN ?='' THEN sender_id ELSE ? END WHERE id=?",
+                    (
+                        merged_content,
+                        candidate.kind or row["kind"],
+                        max(float(row["importance"]), float(candidate.importance)),
+                        merged_confidence,
+                        candidate.source or row["source"],
+                        fingerprint(merged_content),
+                        now,
+                        expires_at if expires_at is not None else row["expires_at"],
+                        str(candidate.sender_id or ""),
+                        str(candidate.sender_id or ""),
+                        row["id"],
+                    ),
+                )
+                self._fts_delete(conn, int(row["id"]))
+                self._fts_insert(conn, int(row["id"]), key, merged_content)
+                conn.commit()
+                updated = conn.execute(
+                    "SELECT * FROM astrbot_memory WHERE id=?", (row["id"],)
+                ).fetchone()
+                return "updated", self._to_record(updated)
+
+            duplicate = conn.execute(
+                "SELECT * FROM astrbot_memory WHERE scope_type=? AND scope_id=? AND fingerprint=?"
+                " AND (expires_at IS NULL OR expires_at > ?) LIMIT 1",
+                (scope_type, scope_id, fp, now),
+            ).fetchone()
+            if duplicate is not None:
+                return "skipped", self._to_record(duplicate)
+
+            cursor = conn.execute(
+                "INSERT INTO astrbot_memory (scope_type, scope_id, mem_key, content, kind,"
+                " importance, confidence, hits, source, sender_id, fingerprint, created_at,"
+                " updated_at, expires_at) VALUES (?,?,?,?,?,?,?,0,?,?,?,?,?,?)",
+                (
+                    scope_type,
+                    scope_id,
+                    key,
+                    content,
+                    candidate.kind or "fact",
+                    float(candidate.importance),
+                    float(candidate.confidence),
+                    candidate.source or "heuristic",
+                    str(candidate.sender_id or ""),
+                    fp,
+                    now,
+                    now,
+                    expires_at,
+                ),
+            )
+            memory_id = int(cursor.lastrowid)
+            self._fts_insert(conn, memory_id, key, content)
+            self._enforce_scope_cap(conn, scope_type, scope_id, now)
+            conn.commit()
+            created = conn.execute(
+                "SELECT * FROM astrbot_memory WHERE id=?", (memory_id,)
+            ).fetchone()
+            return "created", self._to_record(created) if created is not None else None
+
+    def _enforce_scope_cap(
+        self, conn: sqlite3.Connection, scope_type: str, scope_id: str, now: float
+    ) -> None:
+        count = conn.execute(
+            "SELECT COUNT(*) AS n FROM astrbot_memory WHERE scope_type=? AND scope_id=?",
+            (scope_type, scope_id),
+        ).fetchone()["n"]
+        overflow = int(count) - self.max_records_per_scope
+        if overflow <= 0:
+            return
+        victims = conn.execute(
+            "SELECT id FROM astrbot_memory WHERE scope_type=? AND scope_id=?"
+            " ORDER BY importance ASC, updated_at ASC LIMIT ?",
+            (scope_type, scope_id, overflow),
+        ).fetchall()
+        for victim in victims:
+            conn.execute("DELETE FROM astrbot_memory WHERE id=?", (victim["id"],))
+            self._fts_delete(conn, int(victim["id"]))
+
+    # ------------------------------------------------------------------
+    # FTS helpers
+    # ------------------------------------------------------------------
+    def _fts_insert(self, conn: sqlite3.Connection, memory_id: int, key: str, content: str) -> None:
+        if not self.fts_enabled:
+            return
+        try:
+            conn.execute(
+                "INSERT INTO astrbot_memory_fts (rowid, mem_key, content, tokens) VALUES (?,?,?,?)",
+                (memory_id, key, content, " ".join(tokenize(f"{key} {content}"))),
+            )
+        except sqlite3.Error as exc:  # pragma: no cover - defensive
+            self.last_error = f"FTS 索引写入失败：{exc}"
+
+    def _fts_delete(self, conn: sqlite3.Connection, memory_id: int) -> None:
+        if not self.fts_enabled:
+            return
+        try:
+            conn.execute("DELETE FROM astrbot_memory_fts WHERE rowid=?", (memory_id,))
+        except sqlite3.Error as exc:  # pragma: no cover - defensive
+            self.last_error = f"FTS 索引删除失败：{exc}"
+
+    # ------------------------------------------------------------------
+    # read path: retrieval
+    # ------------------------------------------------------------------
+    def search(
+        self,
+        scopes: Iterable[tuple[str, str]],
+        query: str,
+        *,
+        limit: int = 8,
+        min_confidence: float = 0.35,
+        query_vector: list[float] | None = None,
+        semantic_model: str = "",
+        semantic_weight: float = 0.0,
+        semantic_min_cosine: float = 0.2,
+    ) -> list[MemoryRecord]:
+        """Return memories relevant to ``query`` inside ``scopes`` only.
+
+        Scope filtering happens in SQL (``_load_candidates``) *before* any
+        score is computed, so an embedding hit can never pull a row from
+        another scope into the result.  ``query_vector`` enables the optional
+        semantic fusion; without it the lexical score is used unchanged.
+        """
+
+        scope_list = [scope for scope in scopes if scope and scope[1]]
+        if not scope_list:
+            return []
+        tokens = tokenize(query, limit=24)
+        now = float(self.clock())
+        with self._lock:
+            conn = self._connect()
+            rows = self._load_candidates(conn, scope_list, now, min_confidence)
+            if not rows:
+                return []
+            relevance = self._relevance_scores(conn, rows, tokens) if tokens else {}
+            semantic_active = query_vector is not None and semantic_weight > 0.0
+            semantic_scores: dict[int, float] = {}
+            max_rel = 0.0
+            if semantic_active:
+                semantic_scores = self._semantic_scores(conn, rows, query_vector, semantic_model)
+                max_rel = max(relevance.values(), default=0.0) or 0.0
+            ranked: list[MemoryRecord] = []
+            for row in rows:
+                record = self._to_record(row)
+                rel = float(relevance.get(record.id, 0.0))
+                if semantic_active:
+                    cosine = float(semantic_scores.get(record.id, 0.0))
+                    if rel <= 0.0 and cosine < semantic_min_cosine:
+                        continue
+                    lexical = (rel / max_rel) if max_rel else 0.0
+                    rel = (1.0 - semantic_weight) * lexical + semantic_weight * cosine
+                elif not rel:
+                    continue
+                age_days = max(0.0, (now - record.updated_at) / 86400.0)
+                recency = 1.0 / (1.0 + age_days / 30.0)
+                score = (
+                    0.55 * rel
+                    + 0.20 * recency
+                    + 0.15 * min(1.0, max(0.0, record.importance))
+                    + 0.10 * min(1.0, max(0.0, record.confidence))
+                )
+                ranked.append(replace(record, score=score))
+        ranked.sort(key=lambda item: item.score, reverse=True)
+        used = ranked[: max(1, int(limit))]
+        if not used:
+            return []
+        return self._mark_used(used, now)
+
+    def _mark_used(self, records: list[MemoryRecord], now: float) -> list[MemoryRecord]:
+        """Bump ``hits``/``last_used_at`` for the rows a retrieval returned.
+
+        Best effort: a failed counter update must never fail the retrieval; the
+        returned records still carry the incremented values.
+        """
+
+        ids = [record.id for record in records]
+        if not ids:
+            return records
+        placeholders = ",".join("?" for _ in ids)
+        try:
+            with self._lock:
+                conn = self._connect()
+                conn.execute(
+                    "UPDATE astrbot_memory SET hits = hits + 1, last_used_at = ?"
+                    f" WHERE id IN ({placeholders})",
+                    (now, *ids),
+                )
+                conn.commit()
+        except sqlite3.Error as exc:  # pragma: no cover - counters are best effort
+            self.last_error = f"记忆使用计数更新失败：{exc}"
+            return records
+        return [replace(record, hits=record.hits + 1, last_used_at=now) for record in records]
+
+    def _load_candidates(
+        self,
+        conn: sqlite3.Connection,
+        scopes: list[tuple[str, str]],
+        now: float,
+        min_confidence: float,
+    ) -> list[sqlite3.Row]:
+        placeholders = ",".join(["(?,?)"] * len(scopes))
+        params: list[object] = []
+        for scope_type, scope_id in scopes:
+            params.extend((scope_type, scope_id))
+        params.extend((now, float(min_confidence)))
+        sql = (
+            "SELECT m.* FROM astrbot_memory m WHERE "
+            f"(m.scope_type, m.scope_id) IN ({placeholders})"
+            " AND (m.expires_at IS NULL OR m.expires_at > ?)"
+            " AND m.confidence >= ?"
+            " ORDER BY m.updated_at DESC LIMIT 400"
+        )
+        try:
+            return list(conn.execute(sql, params).fetchall())
+        except sqlite3.Error as exc:  # pragma: no cover - defensive
+            self.last_error = f"记忆检索失败：{exc}"
+            return []
+
+    def _relevance_scores(
+        self,
+        conn: sqlite3.Connection,
+        rows: list[sqlite3.Row],
+        tokens: list[str],
+    ) -> dict[int, float]:
+        allowed = {int(row["id"]) for row in rows}
+        if self.fts_enabled:
+            scores = self._fts_scores(conn, tokens, allowed)
+            if scores:
+                return scores
+        return self._bm25_fallback(rows, tokens)
+
+    def _fts_scores(
+        self, conn: sqlite3.Connection, tokens: list[str], allowed: set[int]
+    ) -> dict[int, float]:
+        query = " OR ".join(f'"{token.replace(chr(34), "")}"' for token in tokens)
+        if not query:
+            return {}
+        try:
+            matched = conn.execute(
+                "SELECT rowid AS id, bm25(astrbot_memory_fts) AS rank FROM astrbot_memory_fts"
+                " WHERE astrbot_memory_fts MATCH ? ORDER BY rank LIMIT 200",
+                (query,),
+            ).fetchall()
+        except sqlite3.Error as exc:  # pragma: no cover - defensive
+            self.last_error = f"FTS 查询失败，改用 BM25 回退：{exc}"
+            return {}
+        scores: dict[int, float] = {}
+        for row in matched:
+            memory_id = int(row["id"])
+            if memory_id not in allowed:
+                continue
+            rank = float(row["rank"])
+            # FTS5 bm25() is <= 0 and more negative means a better match.
+            scores[memory_id] = (-rank) / (1.0 - rank) if rank < 0 else 0.0
+        return scores
+
+    def _bm25_fallback(self, rows: list[sqlite3.Row], tokens: list[str]) -> dict[int, float]:
+        """Small BM25-ish scorer, used when SQLite was built without FTS5."""
+
+        documents: dict[int, set[str]] = {}
+        for row in rows:
+            documents[int(row["id"])] = set(tokenize(f"{row['mem_key']} {row['content']}"))
+        total = max(1, len(documents))
+        doc_freq = {token: sum(1 for doc in documents.values() if token in doc) for token in tokens}
+        weights = {token: math.log(1.0 + total / (1.0 + doc_freq[token])) for token in tokens}
+        total_weight = sum(weights.values()) or 1.0
+        scores: dict[int, float] = {}
+        for memory_id, document in documents.items():
+            overlap = sum(weight for token, weight in weights.items() if token in document)
+            if overlap:
+                scores[memory_id] = min(1.0, overlap / total_weight)
+        return scores
+
+    # ------------------------------------------------------------------
+    # optional semantic layer (embedding BLOBs, cosine, fail-open)
+    # ------------------------------------------------------------------
+    def put_embedding(
+        self,
+        memory_id: int,
+        model: str,
+        vector: list[float],
+        now: float | None = None,
+    ) -> bool:
+        """Store one embedding vector (packed little-endian float32 BLOB)."""
+
+        values = [float(value) for value in vector]
+        if not values:
+            return False
+        payload = struct.pack(f"<{len(values)}f", *values)
+        current = float(self.clock() if now is None else now)
+        try:
+            with self._lock:
+                conn = self._connect()
+                conn.execute(
+                    "INSERT OR REPLACE INTO astrbot_memory_embeddings"
+                    " (memory_id, model, dim, vector, updated_at) VALUES (?,?,?,?,?)",
+                    (int(memory_id), str(model or "local"), len(values), payload, current),
+                )
+                conn.commit()
+            return True
+        except sqlite3.Error as exc:  # pragma: no cover - embeddings are best effort
+            self.last_error = f"向量写入失败（语义检索降级）：{exc}"
+            return False
+
+    def _load_embeddings(
+        self,
+        conn: sqlite3.Connection,
+        ids: list[int],
+        model: str,
+    ) -> dict[int, list[float]]:
+        if not ids:
+            return {}
+        placeholders = ",".join("?" for _ in ids)
+        sql = (
+            "SELECT memory_id, dim, vector FROM astrbot_memory_embeddings"
+            f" WHERE memory_id IN ({placeholders})"
+        )
+        params: list[object] = list(ids)
+        if model:
+            sql += " AND model=?"
+            params.append(model)
+        vectors: dict[int, list[float]] = {}
+        for row in conn.execute(sql, params).fetchall():
+            dim = int(row["dim"])
+            blob = row["vector"]
+            if dim <= 0 or not isinstance(blob, (bytes, bytearray)) or len(blob) != dim * 4:
+                continue
+            vectors[int(row["memory_id"])] = list(struct.unpack(f"<{dim}f", blob))
+        return vectors
+
+    def _semantic_scores(
+        self,
+        conn: sqlite3.Connection,
+        rows: list[sqlite3.Row],
+        query_vector: list[float],
+        model: str,
+    ) -> dict[int, float]:
+        allowed = [int(row["id"]) for row in rows]
+        vectors = self._load_embeddings(conn, allowed, model)
+        query_norm = math.sqrt(sum(value * value for value in query_vector)) or 0.0
+        if query_norm <= 0.0:
+            return {}
+        scores: dict[int, float] = {}
+        for memory_id, vector in vectors.items():
+            if len(vector) != len(query_vector):
+                continue
+            norm = math.sqrt(sum(value * value for value in vector)) or 0.0
+            if norm <= 0.0:
+                continue
+            dot = sum(left * right for left, right in zip(query_vector, vector))
+            scores[memory_id] = max(0.0, min(1.0, dot / (query_norm * norm)))
+        return scores
+
+    def embedding_stats(self) -> dict:
+        with self._lock:
+            conn = self._connect()
+            rows = conn.execute(
+                "SELECT model, COUNT(*) AS n FROM astrbot_memory_embeddings GROUP BY model"
+            ).fetchall()
+            rows_total = conn.execute("SELECT COUNT(*) AS n FROM astrbot_memory").fetchone()["n"]
+        embedded = sum(int(row["n"]) for row in rows)
+        return {
+            "embedded": embedded,
+            "records": int(rows_total),
+            "by_model": {row["model"]: int(row["n"]) for row in rows},
+        }
+
+    def records_missing_embeddings(
+        self,
+        scopes: Iterable[tuple[str, str]],
+        *,
+        model: str = "",
+        limit: int = 200,
+    ) -> list[MemoryRecord]:
+        """Rows in ``scopes`` that still need an embedding (backfill input)."""
+
+        scope_list = [scope for scope in scopes if scope and scope[1]]
+        if not scope_list:
+            return []
+        placeholders = ",".join(["(?,?)"] * len(scope_list))
+        params: list[object] = []
+        for scope_type, scope_id in scope_list:
+            params.extend((scope_type, scope_id))
+        params.append(int(limit))
+        sql = (
+            "SELECT m.* FROM astrbot_memory m LEFT JOIN astrbot_memory_embeddings e"
+            " ON e.memory_id = m.id"
+            + (" AND e.model=?" if model else "")
+            + f" WHERE (m.scope_type, m.scope_id) IN ({placeholders}) AND e.memory_id IS NULL"
+            " ORDER BY m.id LIMIT ?"
+        )
+        if model:
+            params.insert(0, model)
+        with self._lock:
+            conn = self._connect()
+            try:
+                rows = conn.execute(sql, params).fetchall()
+            except sqlite3.Error as exc:  # pragma: no cover - defensive
+                self.last_error = f"向量回填查询失败：{exc}"
+                return []
+        return [self._to_record(row) for row in rows]
+
+    def backfill_embeddings(
+        self,
+        provider,
+        *,
+        scopes: Iterable[tuple[str, str]],
+        batch: int = 16,
+        limit: int = 200,
+        now: float | None = None,
+    ) -> dict:
+        """Embed rows that have no vector yet. Fail-open: returns an error string."""
+
+        model = str(getattr(provider, "model", "") or "")
+        result = {"scanned": 0, "embedded": 0, "failed": 0, "error": ""}
+        pending = self.records_missing_embeddings(scopes, model=model, limit=limit)
+        result["scanned"] = len(pending)
+        if not pending:
+            return result
+        size = max(1, int(batch))
+        for start in range(0, len(pending), size):
+            chunk = pending[start : start + size]
+            texts = [f"{record.key} {record.content}"[:400] for record in chunk]
+            try:
+                vectors = provider.embed(texts)
+            except Exception as exc:  # noqa: BLE001 - provider is optional
+                result["error"] = f"向量回填失败（已跳过）：{type(exc).__name__}"
+                result["failed"] = len(chunk)
+                break
+            if len(vectors) != len(chunk):
+                result["error"] = "向量回填失败（返回数量不符）"
+                result["failed"] = len(chunk)
+                break
+            for record, vector in zip(chunk, vectors):
+                if self.put_embedding(record.id, model, vector, now=now):
+                    result["embedded"] += 1
+                else:
+                    result["failed"] += 1
+        return result
+
+    def merge_records(self, keep_id: int, drop_ids: Iterable[int]) -> MemoryRecord | None:
+        """Merge duplicates into ``keep_id``: sum hits, keep the best scores.
+
+        Used only by reflection's explicit apply step; contradictions and
+        low-value rows are never passed here (reflection reports them).
+        """
+
+        drops = [int(memory_id) for memory_id in drop_ids if int(memory_id) != int(keep_id)]
+        with self._lock:
+            conn = self._connect()
+            keeper = conn.execute(
+                "SELECT * FROM astrbot_memory WHERE id=?", (int(keep_id),)
+            ).fetchone()
+            if keeper is None:
+                return None
+            if not drops:
+                return self._to_record(keeper)
+            placeholders = ",".join("?" for _ in drops)
+            stats = conn.execute(
+                "SELECT COALESCE(SUM(hits),0) AS hits, MAX(importance) AS importance,"
+                f" MAX(confidence) AS confidence FROM astrbot_memory WHERE id IN ({placeholders})",
+                drops,
+            ).fetchone()
+            conn.execute(
+                "UPDATE astrbot_memory SET hits=hits+?, importance=MAX(importance, ?),"
+                " confidence=MAX(confidence, ?), updated_at=? WHERE id=?",
+                (
+                    int(stats["hits"] or 0),
+                    float(stats["importance"] or 0.0),
+                    float(stats["confidence"] or 0.0),
+                    float(self.clock()),
+                    int(keep_id),
+                ),
+            )
+            for memory_id in drops:
+                conn.execute("DELETE FROM astrbot_memory WHERE id=?", (memory_id,))
+                conn.execute(
+                    "DELETE FROM astrbot_memory_embeddings WHERE memory_id=?", (memory_id,)
+                )
+                self._fts_delete(conn, memory_id)
+            conn.commit()
+            row = conn.execute("SELECT * FROM astrbot_memory WHERE id=?", (int(keep_id),)).fetchone()
+        return self._to_record(row) if row is not None else None
+
+    # ------------------------------------------------------------------
+    # primitives: forget / delete / export / TTL
+    # ------------------------------------------------------------------
+    def delete(self, memory_id: int) -> bool:
+        with self._lock:
+            conn = self._connect()
+            cursor = conn.execute("DELETE FROM astrbot_memory WHERE id=?", (int(memory_id),))
+            self._fts_delete(conn, int(memory_id))
+            conn.commit()
+            return cursor.rowcount > 0
+
+    def forget(self, scope_type: str, scope_id: str, key: str | None = None) -> int:
+        with self._lock:
+            conn = self._connect()
+            params: list[object] = [scope_type, scope_id]
+            sql = "SELECT id FROM astrbot_memory WHERE scope_type=? AND scope_id=?"
+            if key:
+                sql += " AND mem_key=?"
+                params.append(normalise_value(key))
+            ids = [int(row["id"]) for row in conn.execute(sql, params).fetchall()]
+            for memory_id in ids:
+                conn.execute("DELETE FROM astrbot_memory WHERE id=?", (memory_id,))
+                self._fts_delete(conn, memory_id)
+            conn.commit()
+            return len(ids)
+
+    def purge_expired(self, now: float | None = None) -> int:
+        current = float(self.clock() if now is None else now)
+        with self._lock:
+            conn = self._connect()
+            ids = [
+                int(row["id"])
+                for row in conn.execute(
+                    "SELECT id FROM astrbot_memory WHERE expires_at IS NOT NULL AND expires_at <= ?",
+                    (current,),
+                ).fetchall()
+            ]
+            for memory_id in ids:
+                conn.execute("DELETE FROM astrbot_memory WHERE id=?", (memory_id,))
+                self._fts_delete(conn, memory_id)
+            conn.commit()
+            return len(ids)
+
+    def export(self, scope_type: str, scope_id: str | None = None) -> list[dict]:
+        """Export **one** scope; a missing scope is an error, not a full dump."""
+
+        scope_type = str(scope_type or "").strip()
+        if not scope_type:
+            raise ValueError("export() 需要显式 scope_type（全库导出请用 export_all()）")
+        return self._export(scope_type, scope_id)
+
+    def export_all(self) -> list[dict]:
+        """Export every scope. Operator/diagnostics only -- plugins must not use it."""
+
+        return self._export(None, None)
+
+    def _export(self, scope_type: str | None, scope_id: str | None) -> list[dict]:
+        with self._lock:
+            conn = self._connect()
+            sql = "SELECT * FROM astrbot_memory"
+            params: list[object] = []
+            clauses: list[str] = []
+            if scope_type:
+                clauses.append("scope_type=?")
+                params.append(scope_type)
+            if scope_id:
+                clauses.append("scope_id=?")
+                params.append(scope_id)
+            if clauses:
+                sql += " WHERE " + " AND ".join(clauses)
+            sql += " ORDER BY id"
+            return [self._to_record(row).as_dict() for row in conn.execute(sql, params).fetchall()]
+
+    def stats(self) -> dict:
+        with self._lock:
+            conn = self._connect()
+            rows = conn.execute(
+                "SELECT scope_type, COUNT(*) AS n FROM astrbot_memory GROUP BY scope_type"
+            ).fetchall()
+            total = conn.execute("SELECT COUNT(*) AS n FROM astrbot_memory").fetchone()["n"]
+            now = float(self.clock())
+            expired = conn.execute(
+                "SELECT COUNT(*) AS n FROM astrbot_memory WHERE expires_at IS NOT NULL"
+                " AND expires_at <= ?",
+                (now,),
+            ).fetchone()["n"]
+        return {
+            "total": int(total),
+            "by_scope": {row["scope_type"]: int(row["n"]) for row in rows},
+            "expired": int(expired),
+            "fts_enabled": self.fts_enabled,
+            "db_path": str(self.db_path),
+        }
+
+    def scope_ids(self) -> list[tuple[str, str]]:
+        """Every distinct ``(scope_type, scope_id)`` pair currently stored."""
+
+        with self._lock:
+            conn = self._connect()
+            rows = conn.execute(
+                "SELECT DISTINCT scope_type, scope_id FROM astrbot_memory"
+                " ORDER BY scope_type, scope_id"
+            ).fetchall()
+        return [(str(row["scope_type"]), str(row["scope_id"])) for row in rows]
+
+    def get(self, memory_id: int) -> MemoryRecord | None:
+        with self._lock:
+            conn = self._connect()
+            row = conn.execute("SELECT * FROM astrbot_memory WHERE id=?", (int(memory_id),)).fetchone()
+            return self._to_record(row) if row is not None else None
+
+    def list_scope(
+        self, scope_type: str, scope_id: str | None = None, *, limit: int = 200
+    ) -> list[MemoryRecord]:
+        with self._lock:
+            conn = self._connect()
+            if scope_id is None:
+                rows = conn.execute(
+                    "SELECT * FROM astrbot_memory WHERE scope_type=? ORDER BY updated_at DESC LIMIT ?",
+                    (scope_type, int(limit)),
+                ).fetchall()
+            else:
+                rows = conn.execute(
+                    "SELECT * FROM astrbot_memory WHERE scope_type=? AND scope_id=?"
+                    " ORDER BY updated_at DESC LIMIT ?",
+                    (scope_type, scope_id, int(limit)),
+                ).fetchall()
+        return [self._to_record(row) for row in rows]
+
+    @staticmethod
+    def _to_record(row: sqlite3.Row) -> MemoryRecord:
+        return MemoryRecord(
+            id=int(row["id"]),
+            scope_type=row["scope_type"],
+            scope_id=row["scope_id"],
+            key=row["mem_key"],
+            content=row["content"],
+            kind=row["kind"],
+            importance=float(row["importance"]),
+            confidence=float(row["confidence"]),
+            hits=int(row["hits"]),
+            source=row["source"],
+            sender_id=str(row["sender_id"] or "") if "sender_id" in row.keys() else "",
+            created_at=float(row["created_at"]),
+            updated_at=float(row["updated_at"]),
+            last_used_at=float(row["last_used_at"]) if row["last_used_at"] is not None else None,
+            expires_at=float(row["expires_at"]) if row["expires_at"] is not None else None,
+        )
