new file mode 100644
index 0000000..e037ae8
--- /dev/null
+++ b/astrbot/core/memory/types.py
@@ -0,0 +1,169 @@
+"""Data types for AstrBot's native long-term memory.
+
+Everything here is stdlib-only on purpose: the memory service must stay usable
+(and unit-testable) without the rest of AstrBot's dependency tree, and the
+pipeline hook must never become a new startup requirement.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+
+SCOPE_TYPES = ("user", "group", "conversation", "persona", "global")
+"""Memory scopes, narrowest first.
+
+* ``user``         -- one person on one platform (private + their own group turns)
+* ``group``        -- one group chat on one platform
+* ``conversation`` -- one AstrBot conversation (``conversation_id``)
+* ``persona``      -- memories shared by every chat using one persona
+* ``global``       -- explicitly shared memories (never written automatically)
+"""
+
+READ_SCOPE_NAMES = SCOPE_TYPES
+
+DEFAULT_IMPORTANCE = 0.5
+DEFAULT_CONFIDENCE = 0.5
+
+
+@dataclass(frozen=True)
+class Candidate:
+    """A memory candidate produced by an extractor, before formation."""
+
+    key: str
+    content: str
+    kind: str = "fact"
+    importance: float = DEFAULT_IMPORTANCE
+    confidence: float = DEFAULT_CONFIDENCE
+    scope_type: str = "user"
+    scope_id: str = ""
+    ttl_seconds: int | None = None
+    source: str = "heuristic"
+
+
+@dataclass(frozen=True)
+class MemoryRecord:
+    """A stored memory row."""
+
+    id: int
+    scope_type: str
+    scope_id: str
+    key: str
+    content: str
+    kind: str = "fact"
+    importance: float = DEFAULT_IMPORTANCE
+    confidence: float = DEFAULT_CONFIDENCE
+    hits: int = 0
+    source: str = "heuristic"
+    created_at: float = 0.0
+    updated_at: float = 0.0
+    last_used_at: float | None = None
+    expires_at: float | None = None
+    score: float = 0.0
+
+    def as_dict(self) -> dict:
+        return {
+            "id": self.id,
+            "scope_type": self.scope_type,
+            "scope_id": self.scope_id,
+            "key": self.key,
+            "content": self.content,
+            "kind": self.kind,
+            "importance": self.importance,
+            "confidence": self.confidence,
+            "hits": self.hits,
+            "source": self.source,
+            "created_at": self.created_at,
+            "updated_at": self.updated_at,
+            "last_used_at": self.last_used_at,
+            "expires_at": self.expires_at,
+            "score": round(self.score, 6),
+        }
+
+
+@dataclass(frozen=True)
+class MemoryContext:
+    """Scope binding for one chat turn.
+
+    ``scopes`` is the *only* place retrieval looks: a private chat never sees
+    group memories and a group never sees another group's memories.
+    """
+
+    platform: str = ""
+    user_id: str = ""
+    group_id: str = ""
+    conversation_id: str = ""
+    persona_id: str = ""
+    is_private: bool = True
+    extra_scopes: tuple[tuple[str, str], ...] = field(default_factory=tuple)
+
+    @property
+    def user_scope(self) -> tuple[str, str]:
+        return ("user", _join_id(self.platform, self.user_id))
+
+    @property
+    def group_scope(self) -> tuple[str, str] | None:
+        if not self.group_id or self.is_private:
+            return None
+        return ("group", _join_id(self.platform, self.group_id))
+
+    @property
+    def conversation_scope(self) -> tuple[str, str] | None:
+        if not self.conversation_id:
+            return None
+        return ("conversation", self.conversation_id)
+
+    @property
+    def persona_scope(self) -> tuple[str, str] | None:
+        if not self.persona_id:
+            return None
+        return ("persona", self.persona_id)
+
+    def write_scopes(self, *, private: str = "user", group: str = "group") -> list[tuple[str, str]]:
+        """Scopes an automatic extraction may write to.
+
+        Only one scope is ever written per turn: a private turn writes to the
+        user scope, a group turn to the group scope.  That single rule is what
+        keeps private facts out of groups and group facts out of private chats.
+        """
+
+        if self.is_private or not self.group_id:
+            return [self.user_scope] if private == "user" else []
+        return [self.group_scope] if group == "group" and self.group_scope else []
+
+    def readable_scopes(
+        self,
+        *,
+        users: bool = True,
+        groups: bool = True,
+        conversation: bool = True,
+        persona: bool = True,
+        global_scope: bool = True,
+    ) -> list[tuple[str, str]]:
+        scopes: list[tuple[str, str]] = []
+        # A group turn never reads the sender's private-user memories: what was
+        # said in a private chat must not surface in a group (and vice versa).
+        if users and self.user_id and (self.is_private or not self.group_id):
+            scopes.append(self.user_scope)
+        if groups and self.group_scope:
+            scopes.append(self.group_scope)
+        if conversation and self.conversation_scope:
+            scopes.append(self.conversation_scope)
+        if persona and self.persona_scope:
+            scopes.append(self.persona_scope)
+        if global_scope:
+            scopes.append(("global", "all"))
+        scopes.extend(self.extra_scopes)
+        # de-duplicate while keeping the narrow-to-broad order
+        seen: set[tuple[str, str]] = set()
+        ordered: list[tuple[str, str]] = []
+        for scope in scopes:
+            if scope not in seen:
+                seen.add(scope)
+                ordered.append(scope)
+        return ordered
+
+
+def _join_id(platform: str, value: str) -> str:
+    platform = (platform or "").strip()
+    value = str(value or "").strip()
+    return f"{platform}:{value}" if platform else value
