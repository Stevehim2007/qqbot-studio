+"""AstrBot native long-term memory (SQLite sidecar, fail-open).
+
+Public API:
+
+* :class:`MemoryService` -- storage + formation + retrieval + TTL/forget/export
+* :func:`get_memory_service` -- process-wide service for a config/data dir
+* :func:`reset_memory_services` -- close cached services (tests/config reload)
+* :mod:`astrbot.core.memory.integration` -- the two pipeline hooks
+  (``inject_memory`` before the LLM, ``enqueue_extraction`` after the reply)
+* :mod:`astrbot.core.memory.policy` -- per-chat policy: only listed groups
+  (``mode="long_term"``) read/write long-term memory, everyone else stays
+  conversation-only, invalid config fails safe
+* :mod:`astrbot.core.memory.reflect` -- deterministic reflection
+  (dry-run/apply, duplicate merge, contradiction report, backup)
+* :mod:`astrbot.core.memory.llm_extract` -- optional LLM extractor
+  (disabled by default, background only, budgeted, fail-open)
+* :mod:`astrbot.core.memory.embed` -- optional semantic retrieval
+  (embedding provider, BLOB vectors, cosine fusion, BM25 fallback)
+
+The package only depends on the standard library, so importing it can never
+add a startup requirement to AstrBot. Retrieval is read-only and bounded;
+extraction is queued and heuristic by default (no extra model call).
+"""
+
+from .embed import (
+    EmbeddingSettings,
+    HttpEmbeddingProvider,
+    LocalHashEmbeddingProvider,
+    build_embedding_provider,
+    cosine,
+)
+from .integration import build_context, enqueue_extraction, inject_memory
+from .llm_extract import LLMExtractionClient, LLMSettings, build_llm_extractor
+from .policy import (
+    MODE_CONVERSATION,
+    MODE_LONG_TERM,
+    MemoryPolicy,
+    PolicyResolver,
+    group_policy_key,
+    parse_policy,
+)
+from .service import (
+    DEFAULT_MEMORY_CONFIG,
+    MemoryService,
+    get_memory_service,
+    normalise_config,
+    reset_memory_services,
+    resolve_db_path,
+    scope_ids,
+)
+from .reflect import ReflectSettings, apply_plan, build_plan
+from .store import MemoryStore
+from .types import (
+    SCOPE_TYPES,
+    Candidate,
+    MemoryContext,
+    MemoryRecord,
+)
+
+__all__ = [
+    "Candidate",
+    "EmbeddingSettings",
+    "HttpEmbeddingProvider",
+    "LLMExtractionClient",
+    "LLMSettings",
+    "LocalHashEmbeddingProvider",
+    "ReflectSettings",
+    "apply_plan",
+    "build_embedding_provider",
+    "build_llm_extractor",
+    "build_plan",
+    "cosine",
+    "DEFAULT_MEMORY_CONFIG",
+    "MemoryContext",
+    "MemoryPolicy",
+    "MemoryRecord",
+    "MemoryService",
+    "MemoryStore",
+    "MODE_CONVERSATION",
+    "MODE_LONG_TERM",
+    "PolicyResolver",
+    "SCOPE_TYPES",
