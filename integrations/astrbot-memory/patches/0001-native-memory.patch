new file mode 100644
index 0000000..32ed401
--- /dev/null
+++ b/astrbot/core/memory/integration.py
@@ -0,0 +1,140 @@
+"""AstrBot pipeline integration: retrieve before the LLM, extract after the reply.
+
+Both entry points are fail-open: a broken/unavailable memory database must
+degrade to "no memory block" and "no extraction", never to a failed reply.
+They use duck-typed access to ``AstrMessageEvent``/``ProviderRequest`` and do
+not import the rest of AstrBot, so they can be unit tested with small fakes.
+"""
+
+from __future__ import annotations
+
+import logging
+from collections.abc import Mapping
+
+from .service import MemoryService, get_memory_service
+from .types import MemoryContext
+
+logger = logging.LoggerAdapter(
+    logging.getLogger("astrbot.memory"),
+    {
+        "plugin_tag": "[astrbot_memory]",
+        # AstrBot's formatter expects these fields; records from the memory
+        # package do not pass through its normal plugin logger filter.
+        "short_levelname": "INFO",
+        "astrbot_version_tag": "",
+    },
+)
+
+INJECTED_EXTRA_KEY = "_memory_injected_ids"
+BLOCK_CHARS_EXTRA_KEY = "_memory_block_chars"
+
+
+_GROUP_MESSAGE_TYPES = frozenset({"groupmessage", "group_message", "groupmsg", "group"})
+
+
+def _safe(getter, default=None):
+    try:
+        value = getter()
+    except Exception:  # noqa: BLE001 - duck-typed event may lack the attribute
+        return default
+    return default if value is None else value
+
+
+def build_context(event, req=None) -> MemoryContext:
+    """Bind memory scopes from an AstrBot event (and its conversation)."""
+
+    platform = str(_safe(lambda: event.get_platform_name(), "") or "")
+    user_id = str(_safe(lambda: event.get_sender_id(), "") or "")
+    group_id = str(_safe(lambda: event.get_group_id(), "") or "")
+    umo = str(_safe(lambda: event.unified_msg_origin, "") or "")
+    group_id = group_id or _group_id_from_umo(umo)
+    is_private = bool(_safe(lambda: event.is_private_chat(), not group_id))
+    conversation = getattr(req, "conversation", None) if req is not None else None
+    conversation_id = str(getattr(conversation, "cid", "") or "")
+    persona_id = str(_safe(lambda: event.get_extra("_trace_persona_id"), "") or "")
+    if not persona_id and conversation is not None:
+        persona_id = str(getattr(conversation, "persona_id", "") or "")
+    if not platform:
+        platform = umo.split(":", 1)[0] if ":" in umo else ""
+    return MemoryContext(
+        platform=platform,
+        user_id=user_id,
+        group_id=group_id,
+        conversation_id=conversation_id,
+        persona_id=persona_id,
+        is_private=is_private,
+    )
+
+
+def _group_id_from_umo(umo: str) -> str:
+    """Group id from ``platform:message_type:session_id`` (AstrBot UMO form).
+
+    Only used when the event does not expose ``group_id`` directly, so a group
+    turn is never mistaken for a private chat (which would apply the private
+    policy to a group).  The middle segment must look like a group type.
+    """
+
+    parts = umo.split(":")
+    if len(parts) < 3:
+        return ""
+    if parts[1].strip().lower() not in _GROUP_MESSAGE_TYPES:
+        return ""
+    return parts[-1].strip()
+
+
+def inject_memory(
+    event,
+    req,
+    config: Mapping | None,
+    *,
+    service: MemoryService | None = None,
+) -> int:
+    """Append a bounded memory block to ``req.system_prompt``.
+
+    Returns the number of injected characters (``0`` when disabled, empty or
+    failed). Never raises.
+    """
+
+    try:
+        active = service or get_memory_service(config)
+        if not active.enabled:
+            return 0
+        if _safe(lambda: event.get_extra(INJECTED_EXTRA_KEY), None):
+            return 0
+        prompt = str(getattr(req, "prompt", "") or "")
+        if not prompt.strip():
+            prompt = str(_safe(lambda: event.message_str, "") or "")
+        context = build_context(event, req)
+        block, records = active.retrieve(context, prompt)
+        if not block:
+            return 0
+        prefix = (getattr(req, "system_prompt", "") or "").rstrip()
+        req.system_prompt = f"{prefix}\n\n{block}" if prefix else block
+        _safe(lambda: event.set_extra(INJECTED_EXTRA_KEY, [record.id for record in records]))
+        _safe(lambda: event.set_extra(BLOCK_CHARS_EXTRA_KEY, len(block)))
+        return len(block)
+    except Exception as exc:  # noqa: BLE001 - memory must never break a reply
+        logger.warning("长期记忆注入失败（已降级为空）：%s", exc)
+        return 0
+
+
+def enqueue_extraction(
+    event,
+    req,
+    llm_text: str,
+    config: Mapping | None,
+    *,
+    service: MemoryService | None = None,
+) -> bool:
+    """Queue this turn for background extraction. Never blocks, never raises."""
+
+    try:
+        active = service or get_memory_service(config)
+        if not active.enabled:
+            return False
+        user_text = str(getattr(req, "prompt", "") or "") or str(
+            _safe(lambda: event.message_str, "") or ""
+        )
+        context = build_context(event, req)
+        return active.enqueue_turn(context, user_text, llm_text or "")
+    except Exception as exc:  # noqa: BLE001 - memory must never break a reply
+        logger.warning("长期记忆抽取入队失败（已忽略）：%s", exc)
+        return False
+
+
+def last_injected_ids(event) -> list[int]:
+    """Debug helper: memory row ids injected into the current turn."""
+
+    value = _safe(lambda: event.get_extra(INJECTED_EXTRA_KEY), []) or []
+    return [int(item) for item in value if isinstance(item, int)]
diff --git a/astrbot/core/memory/llm_extract.py b/astrbot/core/memory/llm_extract.py
new file mode 100644
index 0000000..d4fd5de
--- /dev/null
+++ b/astrbot/core/memory/llm_extract.py
@@ -0,0 +1,353 @@
+"""Optional LLM-assisted extraction -- off by default, fail-open, bounded.
+
+The heuristic extractor stays the default.  When an operator enables this
+client, it only ever runs **inside the background extraction worker** (after
+the reply was sent), never on the reply path, and every failure degrades to
+"use the heuristic result only":
+
+* hard input cap (``max_input_chars``) and a lifetime call budget
+  (``max_calls``) so a busy group cannot spend unbounded money;
+* ``timeout_s`` wraps the blocking HTTP call; the caller awaits an async
+  function, which the service runs in its own worker task;
+* messages that look like they contain credentials are never sent;
+* model output is validated and scrubbed: secrets are dropped, content is
+  truncated, scopes are stamped by the service (never trusted from the model);
+* logs contain counts and error *types*, never message content.
+
+Transport is injectable: tests use a stub, so no real (paid) request is made.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import logging
+import os
+import re
+import urllib.error
+import urllib.request
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+
+from .text import MAX_CONTENT_CHARS, contains_secret, fingerprint, scrub_secrets
+from .types import Candidate, MemoryContext
+
+logger = logging.LoggerAdapter(
+    logging.getLogger("astrbot.memory"),
+    {
+        "plugin_tag": "[astrbot_memory]",
+        # AstrBot's formatter expects these fields; records from the memory
+        # package do not pass through its normal plugin logger filter.
+        "short_levelname": "INFO",
+        "astrbot_version_tag": "",
+    },
+)
+
+DEFAULT_ENDPOINT_PATH = "/v1/chat/completions"
+DEFAULT_TIMEOUT_S = 8.0
+DEFAULT_MAX_INPUT_CHARS = 800
+DEFAULT_MAX_CANDIDATES = 5
+DEFAULT_MAX_CALLS = 50
+MAX_ERROR_CHARS = 160
+
+_SYSTEM_PROMPT = (
+    "You extract long-term facts a chat bot should remember about the speaker "
+    "or their group. Reply with JSON only: "
+    '{"facts":[{"key":"short stable key","content":"one short sentence",'
+    '"kind":"fact|preference|identity|profile|habit|note",'
+    '"importance":0.0-1.0,"confidence":0.0-1.0}]}. '
+    "Never include passwords, keys, tokens or account credentials. "
+    "If nothing is worth remembering, reply {\"facts\":[]}."
+)
+
+_JSON_BLOCK = re.compile(r"\{.*\}", re.S)
+_FENCE = re.compile(r"^```[a-zA-Z]*\s*|\s*```$")
+_KINDS = frozenset({"fact", "preference", "identity", "profile", "habit", "note"})
+
+
+@dataclass(frozen=True)
+class LLMSettings:
+    """Connection + budget knobs for the optional LLM extractor."""
+
+    enable: bool = False
+    endpoint: str = ""
+    model: str = ""
+    api_key_env: str = "ASTRBOT_MEMORY_LLM_API_KEY"
+    timeout_s: float = DEFAULT_TIMEOUT_S
+    max_input_chars: int = DEFAULT_MAX_INPUT_CHARS
+    max_candidates: int = DEFAULT_MAX_CANDIDATES
+    max_calls: int = DEFAULT_MAX_CALLS
+
+    @classmethod
+    def from_mapping(cls, mapping) -> tuple["LLMSettings", list[str]]:
+        raw = mapping if isinstance(mapping, Mapping) else {}
+        errors: list[str] = []
+
+        def _bool(name: str, default: bool) -> bool:
+            value = raw.get(name)
+            if value is None:
+                return default
+            if not isinstance(value, bool):
+                errors.append(f"llm.{name} 必须是 true/false")
+                return default
+            return value
+
+        def _float(name: str, default: float, low: float, high: float) -> float:
+            value = raw.get(name)
+            if value is None:
+                return default
+            if isinstance(value, bool) or not isinstance(value, (int, float)):
+                errors.append(f"llm.{name} 必须是数字")
+                return default
+            return min(high, max(low, float(value)))
+
+        def _int(name: str, default: int, low: int, high: int) -> int:
+            value = raw.get(name)
+            if value is None:
+                return default
+            if isinstance(value, bool) or not isinstance(value, int):
+                errors.append(f"llm.{name} 必须是整数")
+                return default
+            return min(high, max(low, value))
+
+        def _text(name: str, default: str) -> str:
+            value = raw.get(name)
+            if value is None:
+                return default
+            if not isinstance(value, str):
+                errors.append(f"llm.{name} 必须是字符串")
+                return default
+            return value.strip()
+
+        endpoint = _text("endpoint", "")
+        if endpoint and not re.match(r"^https?://", endpoint, re.I):
+            errors.append("llm.endpoint 必须以 http(s):// 开头")
+            endpoint = ""
+        return (
+            cls(
+                enable=_bool("enable", False),
+                endpoint=endpoint,
+                model=_text("model", ""),
+                api_key_env=_text("api_key_env", "ASTRBOT_MEMORY_LLM_API_KEY")
+                or "ASTRBOT_MEMORY_LLM_API_KEY",
+                timeout_s=_float("timeout_s", DEFAULT_TIMEOUT_S, 1.0, 60.0),
+                max_input_chars=_int("max_input_chars", DEFAULT_MAX_INPUT_CHARS, 80, 4000),
+                max_candidates=_int("max_candidates", DEFAULT_MAX_CANDIDATES, 1, 20),
+                max_calls=_int("max_calls", DEFAULT_MAX_CALLS, 0, 100_000),
+            ),
+            errors,
+        )
+
+    def as_dict(self) -> dict:
+        return {
+            "enable": self.enable,
+            "endpoint": self.endpoint,
+            "model": self.model,
+            "api_key_env": self.api_key_env,
+            "timeout_s": self.timeout_s,
+            "max_input_chars": self.max_input_chars,
+            "max_candidates": self.max_candidates,
+            "max_calls": self.max_calls,
+        }
+
+
+Transport = Callable[[str, dict, bytes, float], tuple[int, bytes]]
+"""``(url, headers, body, timeout) -> (status, body)``; injectable for tests."""
+
+
+def _urllib_transport(url: str, headers: dict, body: bytes, timeout: float) -> tuple[int, bytes]:
+    request = urllib.request.Request(url, data=body, headers=headers, method="POST")
+    try:
+        with urllib.request.urlopen(request, timeout=timeout) as response:  # noqa: S310 - operator endpoint
+            return int(response.status), response.read()
+    except urllib.error.HTTPError as exc:  # body carries the API error message
+        return int(exc.code), exc.read() if hasattr(exc, "read") else b""
+
+
+class LLMExtractionClient:
+    """Async, budgeted, fail-open extractor compatible with ``set_llm_extractor``."""
+
+    def __init__(
+        self,
+        settings: LLMSettings,
+        *,
+        transport: Transport | None = None,
+        clock: Callable[[], float] = lambda: 0.0,
+    ) -> None:
+        self.settings = settings
+        self._transport = transport or _urllib_transport
+        self.clock = clock
+        self.calls = 0
+        self.skipped = 0
+        self.last_error = ""
+
+    # -- public API -----------------------------------------------------
+    def stats(self) -> dict:
+        return {
+            "enabled": self.settings.enable,
+            "model": self.settings.model,
+            "calls": self.calls,
+            "skipped": self.skipped,
+            "budget": self.settings.max_calls,
+            "budget_exhausted": self.budget_exhausted,
+            "last_error": self.last_error,
+        }
+
+    @property
+    def budget_exhausted(self) -> bool:
+        # ``max_calls == 0`` means "no call at all" (the safe reading of a
+        # zero budget), never "unlimited".
+        return self.calls >= int(self.settings.max_calls)
+
+    async def __call__(self, text: str, context: MemoryContext) -> list[Candidate]:
+        """Return extra candidates; always resolves (never raises)."""
+
+        try:
+            return await self._extract(text, context)
+        except asyncio.CancelledError:  # pragma: no cover - shutdown
+            raise
+        except Exception as exc:  # noqa: BLE001 - optional feature must fail open
+            self.last_error = f"LLM 抽取失败（已回退 heuristic）：{type(exc).__name__}"
+            logger.warning(self.last_error)
+            return []
+
+    # -- internals ------------------------------------------------------
+    async def _extract(self, text: str, context: MemoryContext) -> list[Candidate]:
+        if not self.settings.enable or not self.settings.endpoint:
+            self.skipped += 1
+            return []
+        content = str(text or "")
+        if not content.strip():
+            self.skipped += 1
+            return []
+        # Credentials are never shipped to a third-party endpoint; the whole
+        # turn is skipped and the heuristic extractor already ignored it.
+        if contains_secret(content):
+            self.skipped += 1
+            return []
+        if self.budget_exhausted:
+            self.skipped += 1
+            return []
+        payload = self._payload(content[: int(self.settings.max_input_chars)])
+        body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
+        headers = {"Content-Type": "application/json"}
+        api_key = os.environ.get(self.settings.api_key_env, "").strip()
+        if api_key:
+            headers["Authorization"] = f"Bearer {api_key}"
+        self.calls += 1
+        status, raw = await asyncio.wait_for(
+            asyncio.to_thread(
+                self._transport, self.settings.endpoint, headers, body, self.settings.timeout_s
+            ),
+            timeout=self.settings.timeout_s + 1.0,
+        )
+        if int(status) != 200:
+            self.last_error = f"LLM 抽取返回 HTTP {int(status)}（已回退）"
+            logger.warning(self.last_error)
+            return []
+        return self._parse(raw, context)
+
+    def _payload(self, text: str) -> dict:
+        model = self.settings.model or "default"
+        return {
+            "model": model,
+            "temperature": 0,
+            "max_tokens": 400,
+            "messages": [
+                {"role": "system", "content": _SYSTEM_PROMPT},
+                {"role": "user", "content": text},
+            ],
+        }
+
+    def _parse(self, raw: bytes, context: MemoryContext) -> list[Candidate]:
+        try:
+            document = json.loads(raw.decode("utf-8", "replace"))
+        except Exception:  # noqa: BLE001 - malformed body degrades to heuristic
+            self.last_error = "LLM 抽取返回非 JSON（已回退）"
+            logger.warning(self.last_error)
+            return []
+        text = self._assistant_text(document)
+        facts = self._facts(text)
+        if facts is None:
+            self.last_error = "LLM 抽取返回非 JSON（已回退）"
+            logger.warning(self.last_error)
+            return []
+        candidates: list[Candidate] = []
+        for item in facts:
+            candidate = self._candidate(item)
+            if candidate is not None:
+                candidates.append(candidate)
+            if len(candidates) >= int(self.settings.max_candidates):
+                break
+        return candidates
+
+    @staticmethod
+    def _assistant_text(document) -> str:
+        if isinstance(document, str):
+            return document
+        if isinstance(document, Mapping):
+            choices = document.get("choices")
+            if isinstance(choices, list) and choices:
+                message = choices[0].get("message") if isinstance(choices[0], Mapping) else None
+                if isinstance(message, Mapping):
+                    return str(message.get("content") or "")
+        return json.dumps(document, ensure_ascii=False) if isinstance(document, (dict, list)) else ""
+
+    @staticmethod
+    def _facts(text: str) -> list | None:
+        """Facts from the model text; ``None`` means "no JSON at all"."""
+
+        cleaned = _FENCE.sub("", str(text or "")).strip()
+        match = _JSON_BLOCK.search(cleaned)
+        if not match:
+            return None
+        try:
+            document = json.loads(match.group(0))
+        except Exception:  # noqa: BLE001 - model prose is not JSON
+            return None
+        if isinstance(document, Mapping):
+            facts = document.get("facts")
+            return list(facts) if isinstance(facts, list) else []
+        return list(document) if isinstance(document, list) else []
+
+    @staticmethod
+    def _candidate(item) -> Candidate | None:
+        if not isinstance(item, Mapping):
+            return None
+        content = str(item.get("content") or "").strip()
+        if not content or contains_secret(content):
+            return None
+        content = scrub_secrets(content)[:MAX_CONTENT_CHARS]
+        key = str(item.get("key") or "").strip() or fingerprint(content)
+
+        def _score(name: str, default: float) -> float:
+            value = item.get(name)
+            if isinstance(value, bool) or not isinstance(value, (int, float)):
+                return default
+            return min(1.0, max(0.0, float(value)))
+
+        kind = str(item.get("kind") or "fact").strip().lower()
+        return Candidate(
+            key=key[:48],
+            content=content,
+            kind=kind if kind in _KINDS else "fact",
+            importance=_score("importance", 0.6),
+            confidence=_score("confidence", 0.6),
+            scope_type="",  # stamped by the service with the policy write scope
+            scope_id="",
+            source="llm",
+        )
+
+
+def build_llm_extractor(
+    section,
+    *,
+    transport: Transport | None = None,
+    enabled: bool = False,
+) -> tuple[LLMExtractionClient | None, list[str]]:
+    """Build the client from ``memory.llm`` (+ the ``llm_extract`` alias).
+
+    Returns ``(None, errors)`` when the feature is off or the endpoint is not
+    configured -- the heuristic extractor then stays the only path.
+    """
+
+    settings, errors = LLMSettings.from_mapping(section)
+    if enabled and not settings.enable:
+        settings = LLMSettings(**{**settings.as_dict(), "enable": True})
+    if not settings.enable:
+        return None, errors
+    if not settings.endpoint:
+        errors.append("llm.endpoint 未配置（LLM 抽取保持关闭）")
+        return None, errors
+    return LLMExtractionClient(settings, transport=transport), errors
