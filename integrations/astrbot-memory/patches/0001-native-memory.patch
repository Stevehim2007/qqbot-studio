index 0000000..bfdaca4
--- /dev/null
+++ b/astrbot/core/memory/service.py
@@ -0,0 +1,973 @@
+"""Memory service: configuration, bounded retrieval, queued extraction.
+
+Design rules (they are the contract of this service):
+
+* fail-open -- any storage/configuration failure degrades to "no memory";
+  a broken memory DB must never break a normal chat reply;
+* no extra model call -- extraction is heuristic (regex) unless the operator
+  explicitly registers an LLM extractor; injection only reads SQLite;
+* scope isolation -- retrieval filters on an explicit allow-list of scopes,
+  so a private chat cannot read group memories and vice versa;
+* bounded -- retrieval, injection and per-scope rows all have hard limits.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import copy
+import json
+import logging
+import os
+import threading
+import time
+from collections.abc import Callable, Iterable, Mapping
+from dataclasses import replace
+from pathlib import Path
+
+from .embed import EmbeddingSettings, build_embedding_provider
+from .extract import LLMExtractor, confirmed_extract
+from .llm_extract import LLMExtractionClient, build_llm_extractor
+from .policy import (
+    MODE_CONVERSATION,
+    SCOPE_GROUP,
+    SCOPE_GROUP_MEMBER,
+    SCOPE_GROUP_USER,
+    SCOPE_USER,
+    MemoryPolicy,
+    PolicyResolver,
+)
+from .reflect import ReflectSettings, apply_plan, build_plan, normalise_scopes
+from .render import DEFAULT_MAX_CHARS, DEFAULT_MAX_ITEMS, render_memory_block
+from .store import MemoryStore
+from .text import normalise_value
+from .types import Candidate, MemoryContext, MemoryRecord
+
+logger = logging.LoggerAdapter(
+    logging.getLogger("astrbot.memory"),
+    {
+        "plugin_tag": "[astrbot_memory]",
+        # AstrBot's formatter expects these fields; records from the memory
+        # package do not pass through its normal plugin logger filter.
+        "short_levelname": "INFO",
+        "astrbot_version_tag": "",
+    },
+)
+
+DEFAULT_MEMORY_CONFIG: dict = {
+    "enable": False,
+    "db_path": "",
+    "max_chars": DEFAULT_MAX_CHARS,
+    "max_items": DEFAULT_MAX_ITEMS,
+    "min_confidence": 0.35,
+    "ttl_days": 0,
+    # NOTE: the old write_private_scope/write_group_scope keys are gone -- the
+    # per-chat policy (memory.policy) picks the write scope (see policy.py).
+    "read_user": True,
+    "read_group": True,
+    "read_conversation": True,
+    "read_persona": True,
+    "read_global": True,
+    "heuristic_extract": True,
+    "llm_extract": False,
+    "queue_size": 64,
+    "max_records_per_scope": 500,
+    # Per-chat gate: nothing is remembered unless a chat is listed with
+    # mode="long_term" (privacy default; see policy.py / CONTRACT.md §5).
+    "policy": {"default_mode": MODE_CONVERSATION},
+    # Optional LLM extraction: never on the reply path, disabled by default.
+    "llm": {
+        "enable": False,
+        "endpoint": "",
+        "model": "",
+        "api_key_env": "ASTRBOT_MEMORY_LLM_API_KEY",
+        "timeout_s": 8.0,
+        "max_input_chars": 800,
+        "max_candidates": 5,
+        "max_calls": 50,
+    },
+    # Optional semantic retrieval: BM25 stays the baseline, disabled by default.
+    "semantic": {
+        "enable": False,
+        "provider": "local",
+        "endpoint": "",
+        "model": "",
+        "timeout_s": 5.0,
+        "max_input_chars": 400,
+        "dim": 64,
+        "min_cosine": 0.2,
+        "weight": 0.3,
+        "auto_backfill": False,
+        "batch": 16,
+    },
+    # Deterministic reflection (report/merge/purge), always on demand only.
+    "reflect": {
+        "similarity": 0.86,
+        "contradiction_similarity": 0.6,
+        "low_value_importance": 0.35,
+        "low_value_hits": 0,
+        "backup": True,
+        "max_scan": 500,
+    },
+}
+
+_PURGE_EVERY_TURNS = 50
+
+
+def _load_policy_sidecar() -> dict | None:
+    """Read the Studio-managed durable policy override, if present.
+
+    AstrBot rewrites ``cmd_config.json`` during start/stop; an external edit
+    to ``memory.policy`` can be lost.  Studio writes the same policy here and
+    the memory service prefers it when readable.  Any failure is ignored:
+    policy persistence must never break a chat reply.
+    """
+    try:
+        raw_path = os.environ.get("ASTRBOT_MEMORY_POLICY_PATH")
+        path = Path(raw_path) if raw_path else default_data_dir() / "memory_policy.json"
+        payload = json.loads(path.read_text(encoding="utf-8-sig"))
+    except Exception:
+        return None
+    if not isinstance(payload, dict):
+        return None
+    policy = payload.get("policy", payload)
+    return copy.deepcopy(policy) if isinstance(policy, dict) else None
+
+
+def normalise_config(config: Mapping | None) -> dict:
+    """Merge a user ``memory`` config section over the defaults."""
+
+    merged = dict(DEFAULT_MEMORY_CONFIG)
+    section: Mapping = {}
+    if isinstance(config, Mapping):
+        candidate = config.get("memory")
+        if isinstance(candidate, Mapping):
+            section = candidate
+        elif "enable" in config and "max_chars" in config:
+            section = config
+    for key, value in section.items():
+        if key in merged:
+            merged[key] = value
+    merged["max_chars"] = max(120, int(merged.get("max_chars") or DEFAULT_MAX_CHARS))
+    merged["max_items"] = max(1, int(merged.get("max_items") or DEFAULT_MAX_ITEMS))
+    merged["queue_size"] = max(1, int(merged.get("queue_size") or 64))
+    merged["max_records_per_scope"] = max(20, int(merged.get("max_records_per_scope") or 500))
+    merged["min_confidence"] = min(1.0, max(0.0, float(merged.get("min_confidence") or 0.35)))
+    merged["ttl_days"] = max(0, int(merged.get("ttl_days") or 0))
+    # The policy section is arbitrary nested config: copy it so per-service
+    # instances never share (or mutate) the module default, and hand it to the
+    # parser untouched -- invalid values are rejected there, not sanitised here.
+    sidecar_policy = _load_policy_sidecar()
+    raw_policy = (
+        sidecar_policy
+        if sidecar_policy is not None
+        else (section.get("policy", DEFAULT_MEMORY_CONFIG["policy"]) if section else DEFAULT_MEMORY_CONFIG["policy"])
+    )
+    merged["policy"] = copy.deepcopy(raw_policy) if raw_policy is not None else {"default_mode": MODE_CONVERSATION}
+    # Optional sections are validated by their own modules (fail-open to the
+    # documented defaults); copy them so services never share state.
+    for optional in ("llm", "semantic", "reflect"):
+        value = section.get(optional, DEFAULT_MEMORY_CONFIG[optional]) if section else DEFAULT_MEMORY_CONFIG[optional]
+        merged[optional] = copy.deepcopy(value) if isinstance(value, Mapping) else {}
+    return merged
+
+
+def default_data_dir() -> Path:
+    """Resolve AstrBot's data directory without importing the heavy core package."""
+
+    try:  # real runtime: AstrBot already resolved ASTRBOT_ROOT/desktop paths
+        from astrbot.core.utils.astrbot_path import get_astrbot_data_path
+
+        return Path(get_astrbot_data_path())
+    except Exception:  # importing astrbot.core pulls the whole app; stay standalone
+        root = os.environ.get("ASTRBOT_ROOT") or os.getcwd()
+        return Path(root) / "data"
+
+
+def resolve_db_path(config: Mapping) -> str:
+    configured = str(config.get("db_path") or "").strip()
+    if configured:
+        return configured
+    return str(default_data_dir() / "astrbot_memory.db")
+
+
+class MemoryService:
+    """Long-term memory for one AstrBot data directory."""
+
+    def __init__(
+        self,
+        config: Mapping | None = None,
+        *,
+        db_path: str | Path | None = None,
+        store: MemoryStore | None = None,
+        clock: Callable[[], float] = time.time,
+    ) -> None:
+        self.config = normalise_config(config)
+        self.clock = clock
+        resolved = str(db_path) if db_path else resolve_db_path(self.config)
+        self.db_path = resolved
+        self.last_error = ""
+        self.dropped_turns = 0
+        self.processed_turns = 0
+        self._store = store or MemoryStore(
+            resolved,
+            enable_fts=True,
+            clock=clock,
+            max_records_per_scope=self.config["max_records_per_scope"],
+        )
+        self._llm_extractor: LLMExtractor | None = None
+        self._explicit_extractor = False
+        self._llm_client: LLMExtractionClient | None = None
+        self._semantic_provider = None
+        self._semantic_settings = EmbeddingSettings()
+        self._optional_errors: list[str] = []
+        self._configure_optional()
+        self._queue: asyncio.Queue | None = None
+        self._worker: asyncio.Task | None = None
+        self._worker_loop: asyncio.AbstractEventLoop | None = None
+        self._turns_since_purge = 0
+        self._policy_resolver = PolicyResolver()
+        self.gated_turns = 0
+        self._lock = threading.Lock()
+
+    # ------------------------------------------------------------------
+    # properties / lifecycle
+    # ------------------------------------------------------------------
+    @property
+    def enabled(self) -> bool:
+        return bool(self.config.get("enable"))
+
+    @property
+    def store(self) -> MemoryStore:
+        return self._store
+
+    @property
+    def fts_enabled(self) -> bool:
+        return bool(self._store.fts_enabled)
+
+    def set_llm_extractor(self, extractor: LLMExtractor | None) -> None:
+        """Register an optional async ``(text, context) -> list[Candidate]``.
+
+        An explicit extractor wins over the config-built one: ``refresh_config``
+        never replaces it (plugins that manage their own model keep control).
+        """
+
+        self._llm_extractor = extractor
+        self._explicit_extractor = extractor is not None
+
+    def _configure_optional(self) -> None:
+        """(Re)build the optional LLM extractor and embedding provider.
+
+        Both are opt-in; any configuration error disables only that feature
+        (recorded in ``optional_errors``) and leaves the heuristic / BM25 path
+        untouched.
+        """
+
+        errors: list[str] = []
+        llm_section = self.config.get("llm") if isinstance(self.config.get("llm"), Mapping) else {}
+        self._llm_enabled = bool(self.config.get("llm_extract")) or bool(
+            llm_section.get("enable")
+        )
+        try:
+            client, llm_errors = build_llm_extractor(
+                self.config.get("llm"), enabled=bool(self.config.get("llm_extract"))
+            )
+            self._llm_client = client
+            errors.extend(llm_errors)
+            if not self._explicit_extractor:
+                self._llm_extractor = client
+        except Exception as exc:  # noqa: BLE001 - optional feature
+            self._llm_client = None
+            if not self._explicit_extractor:
+                self._llm_extractor = None
+            errors.append(f"LLM 抽取配置无效（保持关闭）：{type(exc).__name__}")
+        try:
+            provider, settings, embed_errors = build_embedding_provider(
+                self.config.get("semantic")
+            )
+            self._semantic_provider = provider
+            self._semantic_settings = settings
+            errors.extend(embed_errors)
+        except Exception as exc:  # noqa: BLE001 - optional feature
+            self._semantic_provider = None
+            errors.append(f"语义检索配置无效（保持关闭）：{type(exc).__name__}")
+        self._optional_errors = errors
+        if errors:
+            logger.info("长期记忆可选能力配置提示：%s", "; ".join(errors))
+
+    def close(self) -> None:
+        if self._worker is not None:
+            try:
+                self._worker.cancel()
+            except RuntimeError:  # pragma: no cover - loop already closed
+                pass
+            self._worker = None
+        self._queue = None
+        self._store.close()
+
+    def refresh_config(self, config: Mapping | None) -> bool:
+        """Apply a hot-reloaded config (policy cache is invalidated)."""
+
+        merged = normalise_config(config)
+        if merged == self.config:
+            return False
+        self.config = merged
+        try:
+            self._store.max_records_per_scope = int(merged["max_records_per_scope"])
+        except Exception:  # noqa: BLE001 - a stale cap must not block the reload
+            logger.warning("长期记忆 max_records_per_scope 热更新失败（继续用旧值）")
+        self._policy_resolver.invalidate()
+        self._configure_optional()
+        logger.info("长期记忆配置已热更新（策略缓存已失效，无需重启）")
+        return True
+
+    # ------------------------------------------------------------------
+    # policy (which chats may remember, and how)
+    # ------------------------------------------------------------------
+    def policy_for(self, context: MemoryContext) -> MemoryPolicy:
+        """Resolve the per-chat policy for this turn (fail-safe conversation)."""
+
+        try:
+            section = self.config.get("policy")
+            return self._policy_resolver.resolve(
+                section,
+                platform=context.platform,
+                group_id=context.group_id,
+                is_private=context.is_private,
+            )
+        except Exception as exc:  # noqa: BLE001 - never break a reply on config
+            self.last_error = f"长期记忆策略解析失败（已按 conversation 处理）：{exc}"
+            logger.warning(self.last_error)
+            return MemoryPolicy(error=str(exc))
+
+    def _policy_scopes(self, context: MemoryContext, policy: MemoryPolicy) -> list[tuple[str, str]]:
+        """Long-term scopes this policy allows for this turn."""
+
+        if not policy.long_term:
+            return []
+        scopes: list[tuple[str, str]] = []
+        if policy.scope in (SCOPE_USER, SCOPE_GROUP_USER) and self.config["read_user"]:
+            if context.user_scope[1]:
+                scopes.append(context.user_scope)
+        if policy.scope in (SCOPE_GROUP, SCOPE_GROUP_USER) and self.config["read_group"]:
+            if context.group_scope:
+                scopes.append(context.group_scope)
+        if policy.scope == SCOPE_GROUP_MEMBER and self.config["read_group"]:
+            # Speaker rows: only this group's rows about this sender, never
+            # another member's and never another group's.
+            if context.group_member_scope:
+                scopes.append(context.group_member_scope)
+        return scopes
+
+    def _write_scope(self, context: MemoryContext, policy: MemoryPolicy) -> tuple[str, str] | None:
+        """Single scope automatic extraction may write for this turn."""
+
+        if not (policy.long_term and policy.extract):
+            return None
+        if context.is_private or not context.group_id:
+            return context.user_scope if policy.scope == SCOPE_USER else None
+        if policy.scope == SCOPE_GROUP_MEMBER:
+            return context.group_member_scope
+        if policy.scope == SCOPE_USER:
+            # Explicit opt-in: this group's turns feed the sender's own memory.
+            return context.user_scope
+        # group / group_user both write the shared group scope (no dual write:
+        # one fact, one row, one owner).
+        return context.group_scope
+
+    # ------------------------------------------------------------------
+    # retrieval
+    # ------------------------------------------------------------------
+    def _readable_scopes(
+        self,
+        context: MemoryContext,
+        policy: MemoryPolicy | None = None,
+    ) -> list[tuple[str, str]]:
+        policy = policy if policy is not None else self.policy_for(context)
+        if not policy.long_term:
+            return []
+        scopes = self._policy_scopes(context, policy)
+        # conversation/persona/global are not group facts: they stay governed by
+        # the read_* flags even when a chat is gated off from long-term memory...
+        # except that a conversation-mode chat reads nothing at all (return above).
+        scopes.extend(
+            context.readable_scopes(
+                users=False,
+                groups=False,
+                conversation=bool(self.config["read_conversation"]),
+                persona=bool(self.config["read_persona"]),
+                global_scope=bool(self.config["read_global"]),
+            )
+        )
+        return list(dict.fromkeys(scopes))
+
+    def retrieve(self, context: MemoryContext, query: str) -> tuple[str, list[MemoryRecord]]:
+        """Return the bounded memory block for this turn and the used records."""
+
+        if not self.enabled or not (query or "").strip():
+            return "", []
+        policy = self.policy_for(context)
+        if not (policy.long_term and policy.inject):
+            self.gated_turns += 1
+            return "", []
+        scopes = self._readable_scopes(context, policy)
+        if not scopes:
+            return "", []
+        max_items = int(policy.max_items or self.config["max_items"])
+        max_chars = int(policy.max_chars or self.config["max_chars"])
+        try:
+            self._maybe_auto_backfill(scopes)
+            records = self._store.search(
+                scopes,
+                query,
+                limit=max(1, max_items * 3),
+                min_confidence=float(self.config["min_confidence"]),
+                query_vector=self._query_vector(query),
+                **_semantic_kwargs(self._semantic_provider, self._semantic_settings),
+            )
+            block, used = render_memory_block(
+                records,
+                max_chars=max_chars,
+                max_items=max_items,
+            )
+            if not block:
+                return "", []
+            return block, used
+        except Exception as exc:  # noqa: BLE001 - fail open, never break the reply
+            self.last_error = f"长期记忆检索失败（已降级为空）：{exc}"
+            logger.warning(self.last_error)
+            return "", []
+
+    # ------------------------------------------------------------------
+    # extraction (queued, never blocking a reply)
+    # ------------------------------------------------------------------
+    def enqueue_turn(
+        self,
+        context: MemoryContext,
+        user_text: str,
+        assistant_text: str = "",
+        *,
+        explicit_candidates: Iterable[Candidate] | None = None,
+    ) -> bool:
+        """Queue one finished turn for extraction. Never blocks, never raises."""
+
+        if not self.enabled:
+            return False
+        policy = self.policy_for(context)
+        if not (policy.long_term and policy.extract):
+            self.gated_turns += 1
+            return False
+        if not (user_text or "").strip() and not explicit_candidates:
+            return False
+        try:
+            loop = asyncio.get_running_loop()
+        except RuntimeError:
+            logger.debug("长期记忆抽取排队失败：当前没有运行中的事件循环")
+            return False
+        try:
+            self._ensure_worker(loop)
+            assert self._queue is not None
+            self._queue.put_nowait((context, user_text, assistant_text, tuple(explicit_candidates or ())))
+            return True
+        except asyncio.QueueFull:
+            self.dropped_turns += 1
+            logger.debug("长期记忆抽取队列已满，丢弃本轮")
+            return False
+        except Exception as exc:  # noqa: BLE001 - fail open
+            self.last_error = f"长期记忆抽取排队失败：{exc}"
+            logger.warning(self.last_error)
+            return False
+
+    def _ensure_worker(self, loop: asyncio.AbstractEventLoop) -> None:
+        if self._queue is not None and self._worker_loop is loop and self._worker and not self._worker.done():
+            return
+        self._queue = asyncio.Queue(maxsize=int(self.config["queue_size"]))
+        self._worker_loop = loop
+        self._worker = loop.create_task(self._worker_main(self._queue))
+
+    async def _worker_main(self, queue: asyncio.Queue) -> None:
+        while True:
+            try:
+                context, user_text, assistant_text, explicit = await queue.get()
+            except asyncio.CancelledError:  # pragma: no cover - shutdown
+                raise
+            try:
+                await self._process_turn(context, user_text, assistant_text, explicit)
+            except asyncio.CancelledError:  # pragma: no cover - shutdown
+                raise
+            except Exception as exc:  # noqa: BLE001 - one bad turn must not kill the worker
+                self.last_error = f"长期记忆抽取失败：{exc}"
+                logger.warning(self.last_error)
+            finally:
+                queue.task_done()
+
+    async def _process_turn(
+        self,
+        context: MemoryContext,
+        user_text: str,
+        assistant_text: str,
+        explicit: tuple[Candidate, ...] = (),
+    ) -> None:
+        policy = self.policy_for(context)
+        write_scope = self._write_scope(context, policy)
+        if write_scope is None:
+            # Toggled off (or extract disabled) while this turn sat in the queue.
+            self.gated_turns += 1
+            return
+        candidates: list[Candidate] = list(explicit)
+        if self.config.get("heuristic_extract", True):
+            candidates.extend(confirmed_extract(user_text, assistant_text, context, scopes=[write_scope]))
+        extractor = self._llm_extractor
+        if extractor is not None and getattr(self, "_llm_enabled", False):
+            try:
+                candidates.extend(await extractor(user_text, context))
+            except Exception as exc:  # noqa: BLE001 - optional extractor is fail-open
+                logger.warning("长期记忆 LLM 抽取失败（已忽略）：%s", exc)
+        if candidates:
+            bound = [self._bind_candidate(candidate, write_scope, context) for candidate in candidates]
+            await asyncio.to_thread(self.store_candidates, bound, allowed_scopes=[write_scope])
+        self.processed_turns += 1
+        self._turns_since_purge += 1
+        if self._turns_since_purge >= _PURGE_EVERY_TURNS:
+            self._turns_since_purge = 0
+            await asyncio.to_thread(self._safe_purge_expired)
+
+    @staticmethod
+    def _bind_candidate(
+        candidate: Candidate,
+        write_scope: tuple[str, str],
+        context: MemoryContext,
+    ) -> Candidate:
+        """Stamp the policy write scope and the speaker on a candidate.
+
+        Extractors (heuristic or LLM) never choose a scope: an empty scope is
+        replaced by the policy scope for this turn, while an explicit scope is
+        left untouched and later dropped by ``allowed_scopes`` if it is not
+        allowed.  ``sender_id`` records who taught the fact.
+        """
+
+        scope_type, scope_id = candidate.scope_type, candidate.scope_id
+        if not scope_id:
+            scope_type, scope_id = write_scope
+        sender_id = candidate.sender_id or str(context.user_id or "")
+        if (scope_type, scope_id, sender_id) == (
+            candidate.scope_type,
+            candidate.scope_id,
+            candidate.sender_id,
+        ):
+            return candidate
+        return replace(
+            candidate, scope_type=scope_type, scope_id=scope_id, sender_id=sender_id
+        )
+
+    def store_candidates(
+        self,
+        candidates: Iterable[Candidate],
+        *,
+        allowed_scopes: Iterable[tuple[str, str]] | None = None,
+    ) -> dict[str, int]:
+        """Synchronous formation for already-extracted candidates.
+
+        ``allowed_scopes`` is the write allow-list of the automatic pipeline
+        (from the per-chat policy).  Candidates aimed at any other scope are
+        dropped instead of remapped -- remapping would push a fact extracted
+        for one chat into another (a leak).  ``None`` (plugins/tests) means
+        "explicit write, no gate".
+        """
+
+        results = {"created": 0, "updated": 0, "skipped": 0}
+        written: list[MemoryRecord] = []
+        allowed = {(str(t), str(i)) for t, i in allowed_scopes} if allowed_scopes is not None else None
+        for candidate in candidates:
+            if allowed is not None and (candidate.scope_type, candidate.scope_id) not in allowed:
+                results["gated"] = results.get("gated", 0) + 1
+                continue
+            try:
+                ttl = candidate.ttl_seconds
+                if ttl is None and self.config["ttl_days"]:
+                    ttl = int(self.config["ttl_days"]) * 86400
+                action, record = self._store.upsert(
+                    Candidate(
+                        key=candidate.key,
+                        content=candidate.content,
+                        kind=candidate.kind,
+                        importance=candidate.importance,
+                        confidence=candidate.confidence,
+                        scope_type=candidate.scope_type,
+                        scope_id=candidate.scope_id,
+                        ttl_seconds=ttl,
+                        source=candidate.source,
+                        sender_id=candidate.sender_id,
+                    )
+                )
+                results[action] = results.get(action, 0) + 1
+                if action in ("created", "updated") and record is not None:
+                    written.append(record)
+            except Exception as exc:  # noqa: BLE001 - fail open per candidate
+                self.last_error = f"长期记忆写入失败：{exc}"
+                logger.warning(self.last_error)
+        if written:
+            self._embed_written(written)
+        return results
+
+    def _embed_written(self, records: list[MemoryRecord]) -> None:
+        """Keep vectors in sync for new/updated rows (only when enabled)."""
+
+        provider = self._semantic_provider
+        if provider is None or not records:
+            return
+        texts = [
+            f"{record.key} {record.content}"[: int(self._semantic_settings.max_input_chars)]
+            for record in records
+        ]
+        try:
+            vectors = provider.embed(texts)
+        except Exception as exc:  # noqa: BLE001 - BM25 stays the baseline
+            self.last_error = f"语义向量写入失败（已跳过）：{type(exc).__name__}"
+            return
+        if len(vectors) != len(records):
+            self.last_error = "语义向量写入失败（返回数量不符）"
+            return
+        model = str(getattr(provider, "model", "") or "")
+        for record, vector in zip(records, vectors):
+            self._store.put_embedding(record.id, model, vector)
+
+    def _query_vector(self, query: str) -> list[float] | None:
+        provider = self._semantic_provider
+        if provider is None or not str(query or "").strip():
+            return None
+        try:
+            vectors = provider.embed(
+                [str(query)[: int(self._semantic_settings.max_input_chars)]]
+            )
+        except Exception as exc:  # noqa: BLE001 - fail open to BM25
+            self.last_error = f"语义检索失败（已回退 BM25）：{type(exc).__name__}"
+            return None
+        return vectors[0] if vectors else None
+
+    def _maybe_auto_backfill(self, scopes: list[tuple[str, str]]) -> None:
+        """Bounded, opt-in backfill before scoring (default off)."""
+
+        if not self._semantic_settings.auto_backfill or self._semantic_provider is None:
+            return
+        provider = self._semantic_provider
+        try:
+            pending = self._store.records_missing_embeddings(
+                scopes,
+                model=str(getattr(provider, "model", "") or ""),
+                limit=max(1, int(self._semantic_settings.batch)),
+            )
+        except Exception:  # noqa: BLE001 - optional
+            return
+        if pending:
+            self._embed_written(pending)
+
+    async def drain(self, timeout: float = 5.0) -> None:
+        """Wait until the queued extraction work is finished (tests/ops)."""
+
+        queue = self._queue
+        if queue is None:
+            return
+        deadline = time.monotonic() + timeout
+        while not queue.empty() and time.monotonic() < deadline:
+            await asyncio.sleep(0.01)
+        try:
+            await asyncio.wait_for(queue.join(), timeout=max(0.01, deadline - time.monotonic()))
+        except asyncio.TimeoutError:  # pragma: no cover - slow storage
+            logger.warning("等待长期记忆队列清空超时")
+
+    # ------------------------------------------------------------------
+    # explicit API (also used by plugins such as qqbot_enhancer)
+    # ------------------------------------------------------------------
+    def add(
+        self,
+        scope_type: str,
+        scope_id: str,
+        key: str,
+        content: str,
+        *,
+        kind: str = "fact",
+        importance: float = 0.6,
+        confidence: float = 0.8,
+        ttl_seconds: int | None = None,
+        source: str = "explicit",
+    ) -> tuple[str, MemoryRecord | None]:
+        """Create/update/skip one memory explicitly (plugin-facing helper)."""
+
+        action, record = self._store.upsert(
+            Candidate(
+                key=key,
+                content=content,
+                kind=kind,
+                importance=importance,
+                confidence=confidence,
+                scope_type=scope_type,
+                scope_id=scope_id,
+                ttl_seconds=ttl_seconds,
+                source=source,
+            )
+        )
+        if action in ("created", "updated") and record is not None:
+            self._embed_written([record])
+        return action, record
+
+    def search(
+        self,
+        context: MemoryContext,
+        query: str,
+        *,
+        limit: int = 8,
+    ) -> list[MemoryRecord]:
+        policy = self.policy_for(context)
+        if not (self.enabled and policy.long_term and policy.inject):
+            self.gated_turns += 1
+            return []
+        scopes = self._readable_scopes(context, policy)
+        if not scopes:
+            return []
+        try:
+            self._maybe_auto_backfill(scopes)
+            return self._store.search(
+                scopes,
+                query,
+                limit=min(int(limit), int(policy.max_items or limit)),
+                min_confidence=float(self.config["min_confidence"]),
+                query_vector=self._query_vector(query),
+                **_semantic_kwargs(self._semantic_provider, self._semantic_settings),
+            )
+        except Exception as exc:  # noqa: BLE001 - fail open
+            self.last_error = f"长期记忆检索失败：{exc}"
+            return []
+
+    def forget(self, scope_type: str, scope_id: str, key: str | None = None) -> int:
+        return self._store.forget(scope_type, scope_id, key)
+
+    def delete(self, memory_id: int) -> bool:
+        return self._store.delete(memory_id)
+
+    def export(self, scope_type: str, scope_id: str | None = None) -> list[dict]:
+        """Export one scope (``scope_type`` is required -- no accidental full dump)."""
+
+        return self._store.export(scope_type, scope_id)
+
+    def export_all(self) -> list[dict]:
+        """Export every scope. Operator/diagnostics only; plugins must not call it."""
+
+        return self._store.export_all()
+
+    def purge_expired(self) -> int:
+        return self._store.purge_expired()
+
+    def _safe_purge_expired(self) -> int:
+        try:
+            return self._store.purge_expired()
+        except Exception as exc:  # noqa: BLE001 - fail open
+            self.last_error = f"长期记忆过期清理失败：{exc}"
+            return 0
+
+    # ------------------------------------------------------------------
+    # optional capabilities (Studio/operator API; plugins do not need these)
+    # ------------------------------------------------------------------
+    def semantic_stats(self) -> dict:
+        provider = self._semantic_provider
+        payload = {
+            "enabled": provider is not None,
+            "provider": self._semantic_settings.provider,
+            "model": str(getattr(provider, "model", "") or ""),
+            "weight": self._semantic_settings.weight,
+            "min_cosine": self._semantic_settings.min_cosine,
+            "auto_backfill": self._semantic_settings.auto_backfill,
+            "errors": list(self._optional_errors),
+        }
+        try:
+            payload.update(self._store.embedding_stats())
+        except Exception as exc:  # noqa: BLE001 - stats must never raise
+            payload["error"] = type(exc).__name__
+        return payload
+
+    def llm_stats(self) -> dict:
+        client = self._llm_client
+        if client is None:
+            return {"enabled": False, "errors": list(self._optional_errors)}
+        payload = client.stats()
+        payload["errors"] = list(self._optional_errors)
+        return payload
+
+    def reflect(
+        self,
+        scopes: Iterable[tuple[str, str]],
+        *,
+        apply: bool = False,
+    ) -> dict:
+        """Deterministic reflection for explicit scopes (no LLM, no network).
+
+        ``apply=False`` is a pure read (dry-run); ``apply=True`` backs the DB
+        up first, then merges duplicates / purges expired rows only.
+        """
+
+        if not self.enabled:
+            return {"ok": False, "error": "长期记忆未启用"}
+        settings = ReflectSettings.from_mapping(self.config.get("reflect"))
+        backup_dir = ""
+        section = self.config.get("reflect")
+        if isinstance(section, Mapping):
+            raw_dir = section.get("backup_dir")
+            backup_dir = str(raw_dir).strip() if isinstance(raw_dir, str) else ""
+        try:
+            plan = build_plan(self._store, scopes, settings=settings, now=self.clock())
+        except Exception as exc:  # noqa: BLE001 - reflection is operator-only
+            self.last_error = f"记忆整理失败：{exc}"
+            logger.warning(self.last_error)
+            return {"ok": False, "error": self.last_error}
+        if not apply:
+            return plan
+        try:
+            return apply_plan(
+                self._store, plan, settings=settings, backup_dir=backup_dir or None
+            )
+        except Exception as exc:  # noqa: BLE001 - never corrupt on a failed pass
+            self.last_error = f"记忆整理写入失败：{exc}"
+            return {"ok": False, "error": self.last_error}
+
+    def reflect_for(self, context: MemoryContext, *, apply: bool = False) -> dict:
+        """Reflect only the scopes this chat's policy allows (opt-in)."""
+
+        policy = self.policy_for(context)
+        if not (self.enabled and policy.long_term):
+            self.gated_turns += 1
+            return {"ok": False, "error": "该会话未启用长期记忆"}
+        scopes = self._policy_scopes(context, policy)
+        if not scopes:
+            self.gated_turns += 1
+            return {"ok": False, "error": "该会话没有可整理的作用域"}
+        return self.reflect(scopes, apply=apply)
+
+    def backfill_semantic(
+        self,
+        scopes: Iterable[tuple[str, str]] | None = None,
+        *,
+        limit: int | None = None,
+    ) -> dict:
+        """Embed rows that have no vector yet (operator/Studio action)."""
+
+        provider = self._semantic_provider
+        if provider is None or not self.enabled:
+            return {"ok": False, "error": "语义检索未启用"}
+        scope_list = normalise_scopes(scopes) if scopes is not None else self._store.scope_ids()
+        if not scope_list:
+            return {"ok": True, "scanned": 0, "embedded": 0, "failed": 0, "error": ""}
+        cap = int(limit or max(1, int(self._semantic_settings.batch)) * 8)
+        try:
+            result = self._store.backfill_embeddings(
+                provider,
+                scopes=scope_list,
+                batch=int(self._semantic_settings.batch),
+                limit=cap,
+                now=self.clock(),
+            )
+        except Exception as exc:  # noqa: BLE001 - optional feature
+            self.last_error = f"语义回填失败：{type(exc).__name__}"
+            return {"ok": False, "error": self.last_error}
+        result["ok"] = not result.get("error")
+        return result
+
+    def stats(self) -> dict:
+        try:
+            payload = self._store.stats()
+        except Exception as exc:  # noqa: BLE001 - fail open
+            return {"total": 0, "by_scope": {}, "error": str(exc)}
+        payload.update(
+            {
+                "enabled": self.enabled,
+                "processed_turns": self.processed_turns,
+                "dropped_turns": self.dropped_turns,
+                "gated_turns": self.gated_turns,
+                "policy": self._policy_summary(),
+                "llm": self.llm_stats(),
+                "semantic": self.semantic_stats(),
+                "last_error": self.last_error or self._store.last_error,
+            }
+        )
+        return payload
+
+    def _policy_summary(self) -> dict:
+        try:
+            section = self.config.get("policy")
+            groups = section.get("groups") if isinstance(section, Mapping) else None
+            return {
+                "default_mode": section.get("default_mode", MODE_CONVERSATION) if isinstance(section, Mapping) else MODE_CONVERSATION,
+                "groups": len(groups) if isinstance(groups, Mapping) else 0,
+                "private": bool(isinstance(section, Mapping) and section.get("private")),
+                "parses": self._policy_resolver.parses,
+            }
+        except Exception:  # noqa: BLE001 - stats must never raise
+            return {"default_mode": MODE_CONVERSATION, "groups": 0, "private": False}
+
+
+def _semantic_kwargs(provider, settings) -> dict:
+    """Search kwargs for the optional semantic layer (empty when disabled)."""
+
+    if provider is None:
+        return {}
+    return {
+        "semantic_model": str(getattr(provider, "model", "") or ""),
+        "semantic_weight": float(settings.weight),
+        "semantic_min_cosine": float(settings.min_cosine),
+    }
+
+
+_SERVICES: dict[str, MemoryService] = {}
+_SERVICES_LOCK = threading.Lock()
+
+
+def get_memory_service(
+    config: Mapping | None = None,
+    *,
+    db_path: str | Path | None = None,
+) -> MemoryService:
+    """Return the process-wide service for this configuration's DB path."""
+
+    merged = normalise_config(config)
+    key = str(db_path) if db_path else resolve_db_path(merged)
+    with _SERVICES_LOCK:
+        service = _SERVICES.get(key)
+        if service is None:
+            service = MemoryService(merged, db_path=key)
+            _SERVICES[key] = service
+        else:
+            # Hot reload: AstrBot re-reads its config every turn, so a policy
+            # edit must apply to the cached service without a restart.
+            try:
+                service.refresh_config(merged)
+            except Exception as exc:  # noqa: BLE001 - stale config beats a crash
+                logger.warning("长期记忆配置热更新失败（继续用旧配置）：%s", exc)
+        return service
+
+
+def reset_memory_services() -> None:
+    """Close and forget every cached service (tests and config reloads)."""
+
+    with _SERVICES_LOCK:
+        services = list(_SERVICES.values())
+        _SERVICES.clear()
+    for service in services:
+        try:
+            service.close()
+        except Exception:  # noqa: BLE001 - best effort shutdown
+            pass
+
+
+def scope_ids(context: MemoryContext) -> dict[str, str]:
+    """Scope id strings for one turn, convenient for plugins."""
+
+    payload = {"user": context.user_scope[1]}
+    if context.group_scope:
+        payload["group"] = context.group_scope[1]
+    if context.conversation_scope:
+        payload["conversation"] = context.conversation_scope[1]
+    if context.persona_scope:
+        payload["persona"] = context.persona_scope[1]
+    payload["global"] = "all"
+    return payload
+
+
+__all__ = [
+    "DEFAULT_MEMORY_CONFIG",
+    "MemoryService",
+    "get_memory_service",
+    "normalise_config",
+    "reset_memory_services",
+    "resolve_db_path",
+    "scope_ids",
+    "normalise_value",
+]
