+    ),
+    (
+        re.compile(r"(?:请?记住|记一下|记下来|别忘了|帮我记住)[:：,，\s]*(?P<v>.{1,120})"),
+        "note", 0.9, 0.92, "{subject}要求记住：{v}", "记录.{v}",
+    ),
+    (
+        re.compile(r"(?i)\b(?:i like|i love|i prefer)\s+(?P<v>[^.,!?\n]{1,40})"),
+        "preference", 0.6, 0.7, "{subject}喜欢：{v}", "preference.{v}",
+    ),
+    (
+        re.compile(r"(?i)\b(?:i hate|i dislike|i don'?t like)\s+(?P<v>[^.,!?\n]{1,40})"),
+        "preference", 0.8, 0.78, "{subject}不喜欢/忌口：{v}", "preference.{v}",
+    ),
+    (
+        re.compile(r"(?i)\b(?:i live in|i'?m from|i am from)\s+(?P<v>[A-Za-z\u4e00-\u9fa5 ,'\-]{2,40})"),
+        "profile", 0.6, 0.7, "{subject}居住地：{v}", "residence",
+    ),
+    (
+        re.compile(r"(?i)\bmy name is\s+(?P<v>[A-Za-z\u4e00-\u9fa5 _\-]{1,30})"),
+        "identity", 0.7, 0.8, "{subject}的名字是：{v}", "name",
+    ),
+    (
+        re.compile(r"(?i)\bremember(?: that)?\s+(?P<v>.{1,120})"),
+        "note", 0.9, 0.92, "{subject}要求记住：{v}", "note.{v}",
+    ),
+)
+
+_CODE_BLOCK = re.compile(r"```.*?```", re.S)
+_URL = re.compile(r"https?://\S+")
+_MENTION = re.compile(r"@\S+")
+
+
+LLMExtractor = Callable[[str, MemoryContext], Awaitable[list[Candidate]]]
+"""Optional async extractor signature: ``(text, context) -> list[Candidate]``."""
+
+
+def _clean_input(text: str) -> str:
+    cleaned = _CODE_BLOCK.sub(" ", str(text or ""))
+    cleaned = _URL.sub(" ", cleaned)
+    cleaned = _MENTION.sub(" ", cleaned)
+    return cleaned.strip()
+
+
+def heuristic_extract(
+    text: str,
+    context: MemoryContext,
+    *,
+    limit: int = MAX_CANDIDATES_PER_TURN,
+    scopes: list[tuple[str, str]] | None = None,
+) -> list[Candidate]:
+    """Extract memory candidates from a user message without calling a model.
+
+    ``scopes`` overrides the context default write scope (the per-chat policy
+    picks it, e.g. ``user`` for a group that opted into ``scope="user"``); the
+    content template's subject follows the scope actually used.
+    """
+
+    cleaned = _clean_input(text)
+    if not cleaned or contains_secret(cleaned):
+        # Never mine a message that looks like it contains credentials.
+        return []
+    cleaned = scrub_secrets(cleaned)
+    write_scopes = list(scopes) if scopes is not None else context.write_scopes()
+    if not write_scopes:
+        return []
+    scope_type, scope_id = write_scopes[0]
+    subject = "用户"
+    if scope_type == "group":
+        subject = "本群"
+    elif scope_type == "group_member":
+        subject = "本群发言人"
+    candidates: list[Candidate] = []
+    seen_keys: set[str] = set()
+    for pattern, kind, importance, confidence, content_tpl, key_tpl in _RULES:
+        for match in pattern.finditer(cleaned):
+            value = (match.groupdict().get("v") or "").strip(" ，,。.；;：:！!？?")
+            if not value:
+                continue
+            if contains_secret(value):
+                continue
+            display = clean_value(value) or value
+            rendered = content_tpl.format(v=display, subject=subject)
+            key = key_tpl.format(v=normalise_value(display))
+            key = normalise_value(key, limit=48)
+            if not key or key in seen_keys:
+                continue
+            seen_keys.add(key)
+            candidates.append(
+                Candidate(
+                    key=key,
+                    content=rendered,
+                    kind=kind,
+                    importance=importance,
+                    confidence=confidence,
+                    scope_type=scope_type,
+                    scope_id=scope_id,
+                    source="heuristic",
+                    sender_id=str(context.user_id or ""),
+                )
+            )
+            if len(candidates) >= limit:
+                return candidates
+    return candidates
+
+
+def confirmed_extract(
+    user_text: str,
+    assistant_text: str,
+    context: MemoryContext,
+    *,
+    scopes: list[tuple[str, str]] | None = None,
+) -> list[Candidate]:
+    """Heuristics plus a small confirmation boost from the assistant reply.
+
+    A reply that explicitly acknowledges the fact ("好的，我记住了") raises
+    confidence; the reply text is never itself mined for facts.
+    """
+
+    candidates = heuristic_extract(user_text, context, scopes=scopes)
+    if not candidates:
+        return []
+    reply = (assistant_text or "").lower()
+    confirmed = any(marker in reply for marker in ("记住了", "已记住", "记下了", "好的，我记", "noted", "got it"))
+    if not confirmed:
+        return candidates
+    return [
+        Candidate(
+            key=candidate.key,
+            content=candidate.content,
+            kind=candidate.kind,
+            importance=candidate.importance,
+            confidence=min(1.0, candidate.confidence + 0.1),
+            scope_type=candidate.scope_type,
+            scope_id=candidate.scope_id,
+            ttl_seconds=candidate.ttl_seconds,
+            source=candidate.source,
+        )
+        for candidate in candidates
+    ]
