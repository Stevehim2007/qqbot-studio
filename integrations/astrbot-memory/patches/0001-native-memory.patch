+++ b/astrbot/core/memory/store.py
@@ -0,0 +1,507 @@
+"""SQLite sidecar storage for AstrBot's long-term memory.
+
+The store is deliberately independent from AstrBot's conversation database
+(``data_v4.db``):
+
+* memory keeps its own file (default ``data/astrbot_memory.db``), so it can be
+  deleted, backed up or forgotten without touching chat history;
+* it is plain ``sqlite3`` from the standard library (no ORM, no migrations);
+* FTS5 is used when the Python build has it, otherwise a small BM25-ish
+  scorer in Python keeps retrieval working (some distro builds lack FTS5).
+"""
+
+from __future__ import annotations
+
+import math
+import sqlite3
+import threading
+import time
+from collections.abc import Iterable
+from dataclasses import replace
+from pathlib import Path
+
+from .text import (
+    MAX_CONTENT_CHARS,
+    contains_secret,
+    fingerprint,
+    is_contradiction,
+    normalise_value,
+    scrub_secrets,
+    similarity,
+    tokenize,
+)
+from .types import Candidate, MemoryRecord
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS astrbot_memory (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    scope_type TEXT NOT NULL,
+    scope_id TEXT NOT NULL,
+    mem_key TEXT NOT NULL,
+    content TEXT NOT NULL,
+    kind TEXT NOT NULL DEFAULT 'fact',
+    importance REAL NOT NULL DEFAULT 0.5,
+    confidence REAL NOT NULL DEFAULT 0.5,
+    hits INTEGER NOT NULL DEFAULT 0,
+    source TEXT NOT NULL DEFAULT 'heuristic',
+    fingerprint TEXT NOT NULL,
+    created_at REAL NOT NULL,
+    updated_at REAL NOT NULL,
+    last_used_at REAL,
+    expires_at REAL,
+    UNIQUE (scope_type, scope_id, mem_key)
+);
+CREATE INDEX IF NOT EXISTS idx_astrbot_memory_scope
+    ON astrbot_memory (scope_type, scope_id);
+"""
+
+FTS_SCHEMA = """
+CREATE VIRTUAL TABLE IF NOT EXISTS astrbot_memory_fts
+    USING fts5(mem_key, content, tokens, tokenize='unicode61');
+"""
+
+DUPLICATE_SIMILARITY = 0.92
+"""Content at least this similar to the stored value is a duplicate (skip)."""
+
+
+class MemoryStore:
+    """Thread-safe SQLite store for long-term memories."""
+
+    def __init__(
+        self,
+        db_path: str | Path,
+        *,
+        enable_fts: bool = True,
+        clock=time.time,
+        max_records_per_scope: int = 500,
+    ) -> None:
+        self.db_path = Path(db_path)
+        self.clock = clock
+        self.max_records_per_scope = max(20, int(max_records_per_scope))
+        self._lock = threading.RLock()
+        self._conn: sqlite3.Connection | None = None
+        self._fts_declared = bool(enable_fts)
+        self.fts_enabled = False
+        self.last_error = ""
+
+    # ------------------------------------------------------------------
+    # connection / schema
+    # ------------------------------------------------------------------
+    def _connect(self) -> sqlite3.Connection:
+        if self._conn is not None:
+            return self._conn
+        self.db_path.parent.mkdir(parents=True, exist_ok=True)
+        conn = sqlite3.connect(str(self.db_path), timeout=5, check_same_thread=False)
+        conn.row_factory = sqlite3.Row
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute("PRAGMA synchronous=NORMAL")
+        conn.execute("PRAGMA busy_timeout=3000")
+        conn.executescript(SCHEMA)
+        if self._fts_declared:
+            try:
+                conn.executescript(FTS_SCHEMA)
+                self.fts_enabled = True
+            except sqlite3.Error as exc:
+                # Distro sqlite3 without FTS5: keep working with the fallback.
+                self.last_error = f"FTS5 不可用，使用 BM25 回退：{exc}"
+                self.fts_enabled = False
+        conn.commit()
+        self._conn = conn
+        return conn
+
+    def close(self) -> None:
+        with self._lock:
+            if self._conn is not None:
+                try:
+                    self._conn.close()
+                finally:
+                    self._conn = None
+
+    # ------------------------------------------------------------------
+    # write path: formation (create / update / skip)
+    # ------------------------------------------------------------------
+    def upsert(self, candidate: Candidate) -> tuple[str, MemoryRecord | None]:
+        """Form a memory: ``created``, ``updated`` or ``skipped``.
+
+        Duplicates are never written twice: the semantic key
+        ``(scope_type, scope_id, mem_key)`` is unique, and a near-identical
+        content or fingerprint inside the same scope is skipped outright.
+        """
+
+        content = scrub_secrets(str(candidate.content or "")).strip()
+        if not content or contains_secret(content):
+            return "skipped", None
+        content = content[:MAX_CONTENT_CHARS]
+        key = normalise_value(scrub_secrets(str(candidate.key or ""))) or fingerprint(content)
+        scope_type = str(candidate.scope_type or "user")
+        scope_id = str(candidate.scope_id or "")
+        if not scope_id:
+            return "skipped", None
+
+        now = float(self.clock())
+        expires_at = now + candidate.ttl_seconds if candidate.ttl_seconds else None
+        fp = fingerprint(content)
+        with self._lock:
+            conn = self._connect()
+            row = conn.execute(
+                "SELECT * FROM astrbot_memory WHERE scope_type=? AND scope_id=? AND mem_key=?",
+                (scope_type, scope_id, key),
+            ).fetchone()
+            if row is not None:
+                if row["fingerprint"] == fp or similarity(row["content"], content) >= DUPLICATE_SIMILARITY:
+                    return "skipped", self._to_record(row)
+                merged_content = content
+                if is_contradiction(row["content"], content):
+                    # The user reversed a preference: the new claim replaces the
+                    # old one but starts at its own confidence instead of
+                    # inheriting the (now stale) accumulated confidence.
+                    merged_confidence = float(candidate.confidence)
+                else:
+                    merged_confidence = min(
+                        1.0, max(row["confidence"], candidate.confidence) + 0.05
+                    )
+                conn.execute(
+                    "UPDATE astrbot_memory SET content=?, kind=?, importance=?, confidence=?,"
+                    " source=?, fingerprint=?, updated_at=?, expires_at=? WHERE id=?",
+                    (
+                        merged_content,
+                        candidate.kind or row["kind"],
+                        max(float(row["importance"]), float(candidate.importance)),
+                        merged_confidence,
+                        candidate.source or row["source"],
+                        fingerprint(merged_content),
+                        now,
+                        expires_at if expires_at is not None else row["expires_at"],
+                        row["id"],
+                    ),
+                )
+                self._fts_delete(conn, int(row["id"]))
+                self._fts_insert(conn, int(row["id"]), key, merged_content)
+                conn.commit()
+                updated = conn.execute(
+                    "SELECT * FROM astrbot_memory WHERE id=?", (row["id"],)
+                ).fetchone()
+                return "updated", self._to_record(updated)
+
+            duplicate = conn.execute(
+                "SELECT * FROM astrbot_memory WHERE scope_type=? AND scope_id=? AND fingerprint=?"
+                " AND (expires_at IS NULL OR expires_at > ?) LIMIT 1",
+                (scope_type, scope_id, fp, now),
+            ).fetchone()
+            if duplicate is not None:
+                return "skipped", self._to_record(duplicate)
+
+            cursor = conn.execute(
+                "INSERT INTO astrbot_memory (scope_type, scope_id, mem_key, content, kind,"
+                " importance, confidence, hits, source, fingerprint, created_at, updated_at,"
+                " expires_at) VALUES (?,?,?,?,?,?,?,0,?,?,?,?,?)",
+                (
+                    scope_type,
+                    scope_id,
+                    key,
+                    content,
+                    candidate.kind or "fact",
+                    float(candidate.importance),
+                    float(candidate.confidence),
+                    candidate.source or "heuristic",
+                    fp,
+                    now,
+                    now,
+                    expires_at,
+                ),
+            )
+            memory_id = int(cursor.lastrowid)
+            self._fts_insert(conn, memory_id, key, content)
+            self._enforce_scope_cap(conn, scope_type, scope_id, now)
+            conn.commit()
+            created = conn.execute(
+                "SELECT * FROM astrbot_memory WHERE id=?", (memory_id,)
+            ).fetchone()
+            return "created", self._to_record(created) if created is not None else None
+
+    def _enforce_scope_cap(
+        self, conn: sqlite3.Connection, scope_type: str, scope_id: str, now: float
+    ) -> None:
+        count = conn.execute(
+            "SELECT COUNT(*) AS n FROM astrbot_memory WHERE scope_type=? AND scope_id=?",
+            (scope_type, scope_id),
+        ).fetchone()["n"]
+        overflow = int(count) - self.max_records_per_scope
+        if overflow <= 0:
+            return
+        victims = conn.execute(
+            "SELECT id FROM astrbot_memory WHERE scope_type=? AND scope_id=?"
+            " ORDER BY importance ASC, updated_at ASC LIMIT ?",
+            (scope_type, scope_id, overflow),
+        ).fetchall()
+        for victim in victims:
+            conn.execute("DELETE FROM astrbot_memory WHERE id=?", (victim["id"],))
+            self._fts_delete(conn, int(victim["id"]))
+
+    # ------------------------------------------------------------------
+    # FTS helpers
+    # ------------------------------------------------------------------
+    def _fts_insert(self, conn: sqlite3.Connection, memory_id: int, key: str, content: str) -> None:
+        if not self.fts_enabled:
+            return
+        try:
+            conn.execute(
+                "INSERT INTO astrbot_memory_fts (rowid, mem_key, content, tokens) VALUES (?,?,?,?)",
+                (memory_id, key, content, " ".join(tokenize(f"{key} {content}"))),
+            )
+        except sqlite3.Error as exc:  # pragma: no cover - defensive
+            self.last_error = f"FTS 索引写入失败：{exc}"
+
+    def _fts_delete(self, conn: sqlite3.Connection, memory_id: int) -> None:
+        if not self.fts_enabled:
+            return
+        try:
+            conn.execute("DELETE FROM astrbot_memory_fts WHERE rowid=?", (memory_id,))
+        except sqlite3.Error as exc:  # pragma: no cover - defensive
+            self.last_error = f"FTS 索引删除失败：{exc}"
+
+    # ------------------------------------------------------------------
+    # read path: retrieval
+    # ------------------------------------------------------------------
+    def search(
+        self,
+        scopes: Iterable[tuple[str, str]],
+        query: str,
+        *,
+        limit: int = 8,
+        min_confidence: float = 0.35,
+    ) -> list[MemoryRecord]:
+        """Return memories relevant to ``query`` inside ``scopes`` only."""
+
+        scope_list = [scope for scope in scopes if scope and scope[1]]
+        if not scope_list:
+            return []
+        tokens = tokenize(query, limit=24)
+        now = float(self.clock())
+        with self._lock:
+            conn = self._connect()
+            rows = self._load_candidates(conn, scope_list, now, min_confidence)
+            if not rows:
+                return []
+            relevance = self._relevance_scores(conn, rows, tokens) if tokens else {}
+            ranked: list[MemoryRecord] = []
+            for row in rows:
+                record = self._to_record(row)
+                rel = float(relevance.get(record.id, 0.0))
+                if not rel:
+                    continue
+                age_days = max(0.0, (now - record.updated_at) / 86400.0)
+                recency = 1.0 / (1.0 + age_days / 30.0)
+                score = (
+                    0.55 * rel
+                    + 0.20 * recency
+                    + 0.15 * min(1.0, max(0.0, record.importance))
+                    + 0.10 * min(1.0, max(0.0, record.confidence))
+                )
+                ranked.append(replace(record, score=score))
+        ranked.sort(key=lambda item: item.score, reverse=True)
+        return ranked[: max(1, int(limit))]
+
+    def _load_candidates(
+        self,
+        conn: sqlite3.Connection,
+        scopes: list[tuple[str, str]],
+        now: float,
+        min_confidence: float,
+    ) -> list[sqlite3.Row]:
+        placeholders = ",".join(["(?,?)"] * len(scopes))
+        params: list[object] = []
+        for scope_type, scope_id in scopes:
+            params.extend((scope_type, scope_id))
+        params.extend((now, float(min_confidence)))
+        sql = (
+            "SELECT m.* FROM astrbot_memory m WHERE "
+            f"(m.scope_type, m.scope_id) IN ({placeholders})"
+            " AND (m.expires_at IS NULL OR m.expires_at > ?)"
+            " AND m.confidence >= ?"
+            " ORDER BY m.updated_at DESC LIMIT 400"
+        )
+        try:
+            return list(conn.execute(sql, params).fetchall())
+        except sqlite3.Error as exc:  # pragma: no cover - defensive
+            self.last_error = f"记忆检索失败：{exc}"
+            return []
+
+    def _relevance_scores(
+        self,
+        conn: sqlite3.Connection,
+        rows: list[sqlite3.Row],
+        tokens: list[str],
+    ) -> dict[int, float]:
+        allowed = {int(row["id"]) for row in rows}
+        if self.fts_enabled:
+            scores = self._fts_scores(conn, tokens, allowed)
+            if scores:
+                return scores
+        return self._bm25_fallback(rows, tokens)
+
+    def _fts_scores(
+        self, conn: sqlite3.Connection, tokens: list[str], allowed: set[int]
+    ) -> dict[int, float]:
+        query = " OR ".join(f'"{token.replace(chr(34), "")}"' for token in tokens)
+        if not query:
+            return {}
+        try:
+            matched = conn.execute(
+                "SELECT rowid AS id, bm25(astrbot_memory_fts) AS rank FROM astrbot_memory_fts"
+                " WHERE astrbot_memory_fts MATCH ? ORDER BY rank LIMIT 200",
+                (query,),
+            ).fetchall()
+        except sqlite3.Error as exc:  # pragma: no cover - defensive
+            self.last_error = f"FTS 查询失败，改用 BM25 回退：{exc}"
+            return {}
+        scores: dict[int, float] = {}
+        for row in matched:
+            memory_id = int(row["id"])
+            if memory_id not in allowed:
+                continue
+            rank = float(row["rank"])
+            # FTS5 bm25() is <= 0 and more negative means a better match.
+            scores[memory_id] = (-rank) / (1.0 - rank) if rank < 0 else 0.0
+        return scores
+
+    def _bm25_fallback(self, rows: list[sqlite3.Row], tokens: list[str]) -> dict[int, float]:
+        """Small BM25-ish scorer, used when SQLite was built without FTS5."""
+
+        documents: dict[int, set[str]] = {}
+        for row in rows:
+            documents[int(row["id"])] = set(tokenize(f"{row['mem_key']} {row['content']}"))
+        total = max(1, len(documents))
+        doc_freq = {token: sum(1 for doc in documents.values() if token in doc) for token in tokens}
+        weights = {token: math.log(1.0 + total / (1.0 + doc_freq[token])) for token in tokens}
+        total_weight = sum(weights.values()) or 1.0
+        scores: dict[int, float] = {}
+        for memory_id, document in documents.items():
+            overlap = sum(weight for token, weight in weights.items() if token in document)
+            if overlap:
+                scores[memory_id] = min(1.0, overlap / total_weight)
+        return scores
+
+    # ------------------------------------------------------------------
+    # primitives: forget / delete / export / TTL
+    # ------------------------------------------------------------------
+    def delete(self, memory_id: int) -> bool:
+        with self._lock:
+            conn = self._connect()
+            cursor = conn.execute("DELETE FROM astrbot_memory WHERE id=?", (int(memory_id),))
+            self._fts_delete(conn, int(memory_id))
+            conn.commit()
+            return cursor.rowcount > 0
+
+    def forget(self, scope_type: str, scope_id: str, key: str | None = None) -> int:
+        with self._lock:
+            conn = self._connect()
+            params: list[object] = [scope_type, scope_id]
+            sql = "SELECT id FROM astrbot_memory WHERE scope_type=? AND scope_id=?"
+            if key:
+                sql += " AND mem_key=?"
+                params.append(normalise_value(key))
+            ids = [int(row["id"]) for row in conn.execute(sql, params).fetchall()]
+            for memory_id in ids:
+                conn.execute("DELETE FROM astrbot_memory WHERE id=?", (memory_id,))
+                self._fts_delete(conn, memory_id)
+            conn.commit()
+            return len(ids)
+
+    def purge_expired(self, now: float | None = None) -> int:
+        current = float(self.clock() if now is None else now)
+        with self._lock:
+            conn = self._connect()
+            ids = [
+                int(row["id"])
+                for row in conn.execute(
+                    "SELECT id FROM astrbot_memory WHERE expires_at IS NOT NULL AND expires_at <= ?",
+                    (current,),
+                ).fetchall()
+            ]
+            for memory_id in ids:
+                conn.execute("DELETE FROM astrbot_memory WHERE id=?", (memory_id,))
+                self._fts_delete(conn, memory_id)
+            conn.commit()
+            return len(ids)
+
+    def export(self, scope_type: str | None = None, scope_id: str | None = None) -> list[dict]:
+        with self._lock:
+            conn = self._connect()
+            sql = "SELECT * FROM astrbot_memory"
+            params: list[object] = []
+            clauses: list[str] = []
+            if scope_type:
+                clauses.append("scope_type=?")
+                params.append(scope_type)
+            if scope_id:
+                clauses.append("scope_id=?")
+                params.append(scope_id)
+            if clauses:
+                sql += " WHERE " + " AND ".join(clauses)
+            sql += " ORDER BY id"
+            return [self._to_record(row).as_dict() for row in conn.execute(sql, params).fetchall()]
+
+    def stats(self) -> dict:
+        with self._lock:
+            conn = self._connect()
+            rows = conn.execute(
+                "SELECT scope_type, COUNT(*) AS n FROM astrbot_memory GROUP BY scope_type"
+            ).fetchall()
+            total = conn.execute("SELECT COUNT(*) AS n FROM astrbot_memory").fetchone()["n"]
+            now = float(self.clock())
+            expired = conn.execute(
+                "SELECT COUNT(*) AS n FROM astrbot_memory WHERE expires_at IS NOT NULL"
+                " AND expires_at <= ?",
+                (now,),
+            ).fetchone()["n"]
+        return {
+            "total": int(total),
+            "by_scope": {row["scope_type"]: int(row["n"]) for row in rows},
+            "expired": int(expired),
+            "fts_enabled": self.fts_enabled,
+            "db_path": str(self.db_path),
+        }
+
+    def get(self, memory_id: int) -> MemoryRecord | None:
+        with self._lock:
+            conn = self._connect()
+            row = conn.execute("SELECT * FROM astrbot_memory WHERE id=?", (int(memory_id),)).fetchone()
+            return self._to_record(row) if row is not None else None
+
+    def list_scope(
+        self, scope_type: str, scope_id: str | None = None, *, limit: int = 200
+    ) -> list[MemoryRecord]:
+        with self._lock:
+            conn = self._connect()
+            if scope_id is None:
+                rows = conn.execute(
+                    "SELECT * FROM astrbot_memory WHERE scope_type=? ORDER BY updated_at DESC LIMIT ?",
+                    (scope_type, int(limit)),
+                ).fetchall()
+            else:
+                rows = conn.execute(
+                    "SELECT * FROM astrbot_memory WHERE scope_type=? AND scope_id=?"
+                    " ORDER BY updated_at DESC LIMIT ?",
+                    (scope_type, scope_id, int(limit)),
+                ).fetchall()
+        return [self._to_record(row) for row in rows]
+
+    @staticmethod
+    def _to_record(row: sqlite3.Row) -> MemoryRecord:
+        return MemoryRecord(
+            id=int(row["id"]),
+            scope_type=row["scope_type"],
+            scope_id=row["scope_id"],
+            key=row["mem_key"],
+            content=row["content"],
+            kind=row["kind"],
+            importance=float(row["importance"]),
+            confidence=float(row["confidence"]),
+            hits=int(row["hits"]),
+            source=row["source"],
+            created_at=float(row["created_at"]),
+            updated_at=float(row["updated_at"]),
+            last_used_at=float(row["last_used_at"]) if row["last_used_at"] is not None else None,
+            expires_at=float(row["expires_at"]) if row["expires_at"] is not None else None,
+        )
diff --git a/astrbot/core/memory/text.py b/astrbot/core/memory/text.py
new file mode 100644
index 0000000..b648472
--- /dev/null
+++ b/astrbot/core/memory/text.py
@@ -0,0 +1,121 @@
+"""Text helpers for the memory service: tokenising, similarity, secret scrubbing."""
+
+from __future__ import annotations
+
+import hashlib
+import re
+
+_CJK = re.compile(r"[\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff]")
+_LATIN = re.compile(r"[a-z0-9][a-z0-9_\-.]*")
+_STRIP_PARTICLES = re.compile(r"(?:的|了|啊|呀|吧|吗|呢|哦|喔|啦|哈)+$")
+
+STOPWORDS = frozenset(
+    {
+        "a", "an", "the", "is", "are", "am", "was", "were", "be", "been",
+        "i", "me", "my", "you", "your", "we", "our", "it", "its", "this",
+        "that", "to", "of", "in", "on", "at", "for", "and", "or", "but",
+        "我", "你", "他", "她", "它", "我们", "你们", "他们", "的", "了",
+        "是", "在", "和", "就", "都", "也", "很", "有", "没有", "吗", "呢",
+        "啊", "呀", "吧", "哦", "这", "那", "一个", "什么", "怎么", "可以",
+    }
+)
+
+# Never persist credentials, tokens or account secrets -- memory is injected
+# back into prompts and must be safe to show.
+SECRET_PATTERNS = (
+    re.compile(r"\bsk-[A-Za-z0-9_\-]{8,}\b"),
+    re.compile(r"\b(?:ak|as|ghp|gho|xox[baprs])[-_][A-Za-z0-9_\-]{8,}\b"),
+    re.compile(r"(?i)\b(?:bearer\s+)[A-Za-z0-9._\-]{12,}\b"),
+    re.compile(r"(?i)\b(?:password|passwd|pwd|api[_-]?key|secret|token)\s*[:=]\s*\S{1,60}"),
+    re.compile(r"(?:密码|口令|密钥|令牌|token)\s*(?:是|为|:|：)\s*\S{1,60}"),
+    re.compile(r"(?i)\b(?:qq|微信|wechat)\s*(?:密码|password)\s*(?:是|为|:|：)?\s*\S+"),
+    re.compile(r"\bQQ[:：]?\s*\d{5,12}\s*[/,，]?\s*(?:密码|口令)\s*[:：]?\s*\S+"),
+)
+REDACTED = "[已隐去]"
+MAX_CONTENT_CHARS = 200
+
+
+def tokenize(text: str, *, limit: int = 64) -> list[str]:
+    """Return search tokens: latin words plus CJK character bigrams."""
+
+    if not text:
+        return []
+    lowered = str(text).lower()
+    tokens: list[str] = [word for word in _LATIN.findall(lowered) if word not in STOPWORDS]
+    cjk_runs = re.findall(r"[\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff]+", lowered)
+    for run in cjk_runs:
+        if len(run) == 1:
+            tokens.append(run)
+        else:
+            tokens.extend(run[i : i + 2] for i in range(len(run) - 1))
+    seen: set[str] = set()
+    ordered: list[str] = []
+    for token in tokens:
+        if len(token) == 1 and not _CJK.match(token):
+            continue
+        if token in STOPWORDS or token in seen:
+            continue
+        seen.add(token)
+        ordered.append(token)
+        if len(ordered) >= limit:
+            break
+    return ordered
+
+
+def clean_value(value: str, *, limit: int = 60) -> str:
+    """Trim an extracted value for display (trailing particles, punctuation)."""
+
+    text = re.sub(r"\s+", " ", str(value or "")).strip()
+    text = text.strip("，,。.；;：:！!？?、\"'“”‘’()（）[]【】")
+    text = _STRIP_PARTICLES.sub("", text)
+    return text[:limit]
+
+
+def normalise_value(value: str, *, limit: int = 32) -> str:
+    """Normalise an extracted value so equivalent facts share one semantic key."""
+
+    text = re.sub(r"\s+", " ", str(value or "")).strip()
+    text = text.strip("，,。.；;：:！!？?、\"'“”‘’()（）[]【】")
+    text = _STRIP_PARTICLES.sub("", text)
+    text = text.lower()
+    return text[:limit]
+
+
+def fingerprint(text: str) -> str:
+    return hashlib.sha1(str(text or "").strip().lower().encode("utf-8")).hexdigest()[:24]
+
+
+def similarity(left: str, right: str) -> float:
+    """Token Jaccard similarity in [0, 1] (cheap, deterministic, explainable)."""
+
+    left_tokens = set(tokenize(left))
+    right_tokens = set(tokenize(right))
+    if not left_tokens or not right_tokens:
+        return 1.0 if normalise_value(left) == normalise_value(right) else 0.0
+    overlap = left_tokens & right_tokens
+    union = left_tokens | right_tokens
+    return len(overlap) / len(union)
+
+
+def contains_secret(text: str) -> bool:
+    return any(pattern.search(str(text or "")) for pattern in SECRET_PATTERNS)
+
+
+def scrub_secrets(text: str) -> str:
+    """Replace secret-looking spans with a placeholder instead of storing them."""
+
+    cleaned = str(text or "")
+    for pattern in SECRET_PATTERNS:
+        cleaned = pattern.sub(REDACTED, cleaned)
+    return cleaned
+
+
+def is_contradiction(old: str, new: str) -> bool:
+    """Detection of polarity flips such as ``喜欢辣`` -> ``不喜欢辣``."""
+
+    old_text = str(old or "")
+    new_text = str(new or "")
+    negative_markers = ("不", "没", "别", "讨厌", "don't", "doesn't", "not ", "hate")
+    old_negative = any(marker in old_text for marker in negative_markers)
+    new_negative = any(marker in new_text for marker in negative_markers)
+    return old_negative != new_negative
