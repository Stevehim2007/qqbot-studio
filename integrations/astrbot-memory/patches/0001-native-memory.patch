diff --git a/astrbot/core/memory/embed.py b/astrbot/core/memory/embed.py
new file mode 100644
index 0000000..ed46f6e
--- /dev/null
+++ b/astrbot/core/memory/embed.py
@@ -0,0 +1,276 @@
+"""Optional semantic layer: embedding providers + cosine fusion.
+
+BM25/FTS5 stays the baseline.  When an operator enables this module:
+
+* an :class:`EmbeddingProvider` turns text into vectors -- either a pure
+  standard-library local hashing provider (default, zero cost, zero network)
+  or an OpenAI-compatible HTTP endpoint (operator supplied);
+* vectors are stored as float32 BLOBs in the sidecar DB (``astrbot_memory_embeddings``);
+* retrieval fuses the lexical score with the cosine similarity
+  (``semantic.weight``), *after* the scope filter, so a vector hit can never
+  cross a scope;
+* every failure (missing vector, provider error, dimension mismatch) degrades
+  to plain BM25; semantic retrieval is off by default.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+import math
+import re
+import urllib.error
+import urllib.request
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+
+from .text import tokenize
+
+logger = logging.LoggerAdapter(
+    logging.getLogger("astrbot.memory"),
+    {
+        "plugin_tag": "[astrbot_memory]",
+        # AstrBot's formatter expects these fields; records from the memory
+        # package do not pass through its normal plugin logger filter.
+        "short_levelname": "INFO",
+        "astrbot_version_tag": "",
+    },
+)
+
+DEFAULT_LOCAL_DIM = 64
+DEFAULT_TIMEOUT_S = 5.0
+DEFAULT_MAX_INPUT_CHARS = 400
+DEFAULT_MIN_COSINE = 0.2
+DEFAULT_WEIGHT = 0.3
+MAX_DIM = 1024
+
+
+@dataclass(frozen=True)
+class EmbeddingSettings:
+    """Operator knobs for the optional semantic layer."""
+
+    enable: bool = False
+    provider: str = "local"
+    endpoint: str = ""
+    model: str = ""
+    api_key_env: str = "ASTRBOT_MEMORY_EMBEDDING_API_KEY"
+    timeout_s: float = DEFAULT_TIMEOUT_S
+    max_input_chars: int = DEFAULT_MAX_INPUT_CHARS
+    dim: int = DEFAULT_LOCAL_DIM
+    min_cosine: float = DEFAULT_MIN_COSINE
+    weight: float = DEFAULT_WEIGHT
+    auto_backfill: bool = False
+    batch: int = 16
+
+    @classmethod
+    def from_mapping(cls, mapping) -> tuple["EmbeddingSettings", list[str]]:
+        raw = mapping if isinstance(mapping, Mapping) else {}
+        errors: list[str] = []
+
+        def _bool(name: str, default: bool) -> bool:
+            value = raw.get(name)
+            if value is None:
+                return default
+            if not isinstance(value, bool):
+                errors.append(f"semantic.{name} 必须是 true/false")
+                return default
+            return value
+
+        def _num(name: str, default: float, low: float, high: float) -> float:
+            value = raw.get(name)
+            if value is None:
+                return default
+            if isinstance(value, bool) or not isinstance(value, (int, float)):
+                errors.append(f"semantic.{name} 必须是数字")
+                return default
+            return min(high, max(low, float(value)))
+
+        def _int(name: str, default: int, low: int, high: int) -> int:
+            value = raw.get(name)
+            if value is None:
+                return default
+            if isinstance(value, bool) or not isinstance(value, int):
+                errors.append(f"semantic.{name} 必须是整数")
+                return default
+            return min(high, max(low, value))
+
+        def _text(name: str, default: str) -> str:
+            value = raw.get(name)
+            if value is None:
+                return default
+            if not isinstance(value, str):
+                errors.append(f"semantic.{name} 必须是字符串")
+                return default
+            return value.strip()
+
+        provider = _text("provider", "local").lower()
+        if provider not in ("local", "http"):
+            errors.append(f"semantic.provider 必须是 local/http，收到 {provider!r}")
+            provider = "local"
+        endpoint = _text("endpoint", "")
+        if provider == "http" and endpoint and not re.match(r"^https?://", endpoint, re.I):
+            errors.append("semantic.endpoint 必须以 http(s):// 开头")
+            endpoint = ""
+        return (
+            cls(
+                enable=_bool("enable", False),
+                provider=provider,
+                endpoint=endpoint,
+                model=_text("model", ""),
+                api_key_env=_text("api_key_env", "ASTRBOT_MEMORY_EMBEDDING_API_KEY")
+                or "ASTRBOT_MEMORY_EMBEDDING_API_KEY",
+                timeout_s=_num("timeout_s", DEFAULT_TIMEOUT_S, 1.0, 30.0),
+                max_input_chars=_int("max_input_chars", DEFAULT_MAX_INPUT_CHARS, 40, 2000),
+                dim=_int("dim", DEFAULT_LOCAL_DIM, 8, MAX_DIM),
+                min_cosine=_num("min_cosine", DEFAULT_MIN_COSINE, 0.0, 1.0),
+                weight=_num("weight", DEFAULT_WEIGHT, 0.0, 1.0),
+                auto_backfill=_bool("auto_backfill", False),
+                batch=_int("batch", 16, 1, 128),
+            ),
+            errors,
+        )
+
+    def as_dict(self) -> dict:
+        return {
+            "enable": self.enable,
+            "provider": self.provider,
+            "endpoint": self.endpoint,
+            "model": self.model,
+            "api_key_env": self.api_key_env,
+            "timeout_s": self.timeout_s,
+            "max_input_chars": self.max_input_chars,
+            "dim": self.dim,
+            "min_cosine": self.min_cosine,
+            "weight": self.weight,
+            "auto_backfill": self.auto_backfill,
+            "batch": self.batch,
+        }
+
+
+EmbedTransport = Callable[[str, dict, bytes, float], tuple[int, bytes]]
+
+
+def _urllib_embed_transport(url: str, headers: dict, body: bytes, timeout: float) -> tuple[int, bytes]:
+    request = urllib.request.Request(url, data=body, headers=headers, method="POST")
+    try:
+        with urllib.request.urlopen(request, timeout=timeout) as response:  # noqa: S310 - operator endpoint
+            return int(response.status), response.read()
+    except urllib.error.HTTPError as exc:
+        return int(exc.code), exc.read() if hasattr(exc, "read") else b""
+
+
+class LocalHashEmbeddingProvider:
+    """Deterministic bag-of-tokens hashing embedding (stdlib only, no network).
+
+    It is not a semantic model: it gives partial credit for shared tokens and
+    handles CJK bigrams through :func:`tokenize`, so it is a cheap way to make
+    fuzzy phrasing match.  Operators who need real semantics configure the
+    HTTP provider instead.
+    """
+
+    def __init__(self, dim: int = DEFAULT_LOCAL_DIM) -> None:
+        self.dim = max(8, min(MAX_DIM, int(dim)))
+        self.model = f"local-hash-{self.dim}"
+
+    def embed(self, texts: list[str]) -> list[list[float]]:
+        return [self._vector(text) for text in texts]
+
+    def _vector(self, text: str) -> list[float]:
+        vector = [0.0] * self.dim
+        tokens = tokenize(str(text or ""), limit=48)
+        for token in tokens:
+            digest = hashlib.sha1(token.encode("utf-8", "replace")).digest()
+            index = int.from_bytes(digest[:4], "little") % self.dim
+            sign = 1.0 if digest[4] % 2 == 0 else -1.0
+            vector[index] += sign
+        norm = math.sqrt(sum(value * value for value in vector))
+        if norm <= 0.0:
+            return vector
+        return [value / norm for value in vector]
+
+
+class HttpEmbeddingProvider:
+    """OpenAI-compatible ``POST {endpoint}`` with ``{"model","input"}``.
+
+    The endpoint is operator-supplied; the API key comes from an environment
+    variable (never from the config file, never logged).
+    """
+
+    def __init__(
+        self,
+        settings: EmbeddingSettings,
+        *,
+        transport: EmbedTransport | None = None,
+    ) -> None:
+        if not settings.endpoint:
+            raise ValueError("semantic.endpoint 未配置")
+        self.settings = settings
+        self.endpoint = settings.endpoint
+        self.model = settings.model or "text-embedding"
+        self.dim = int(settings.dim)
+        self._transport = transport or _urllib_embed_transport
+
+    def embed(self, texts: list[str]) -> list[list[float]]:
+        payload = {
+            "model": self.model,
+            "input": [str(text or "")[: self.settings.max_input_chars] for text in texts],
+        }
+        body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
+        headers = {"Content-Type": "application/json"}
+        import os  # local import: the provider is only built when enabled
+
+        api_key = os.environ.get(self.settings.api_key_env, "").strip()
+        if api_key:
+            headers["Authorization"] = f"Bearer {api_key}"
+        status, raw = self._transport(
+            self.endpoint, headers, body, float(self.settings.timeout_s)
+        )
+        if int(status) != 200:
+            raise RuntimeError(f"embedding endpoint HTTP {int(status)}")
+        document = json.loads(raw.decode("utf-8", "replace"))
+        data = document.get("data") if isinstance(document, Mapping) else None
+        if not isinstance(data, list) or len(data) != len(texts):
+            raise RuntimeError("embedding 返回结构不符")
+        vectors: list[list[float]] = []
+        for item in data:
+            vector = item.get("embedding") if isinstance(item, Mapping) else None
+            if not isinstance(vector, list) or not vector:
+                raise RuntimeError("embedding 返回空向量")
+            vectors.append([float(value) for value in vector])
+        first = len(vectors[0])
+        if any(len(vector) != first for vector in vectors):
+            raise RuntimeError("embedding 维度不一致")
+        if first != self.dim:
+            # Trust the endpoint's dimension once, then keep it stable.
+            self.dim = first
+        return vectors
+
+
+Provider = LocalHashEmbeddingProvider | HttpEmbeddingProvider
+
+
+def build_embedding_provider(
+    mapping,
+    *,
+    transport: EmbedTransport | None = None,
+) -> tuple[Provider | None, EmbeddingSettings, list[str]]:
+    """Build the configured provider; ``(None, settings, errors)`` when off."""
+
+    settings, errors = EmbeddingSettings.from_mapping(mapping)
+    if not settings.enable:
+        return None, settings, errors
+    if settings.provider == "http":
+        if not settings.endpoint:
+            errors.append("semantic.endpoint 未配置（语义检索保持关闭）")
+            return None, settings, errors
+        return HttpEmbeddingProvider(settings, transport=transport), settings, errors
+    if settings.model:
+        # Local provider owns its model name; keep the operator string in the
+        # settings for stats, but the vectors stay keyed by the local model.
+        errors.append("semantic.model 对 local provider 无效（已忽略）")
+    return LocalHashEmbeddingProvider(settings.dim), settings, errors
+
+
+def cosine(left: list[float], right: list[float]) -> float:
+    """Cosine similarity in [0, 1] (0 for empty/ill-sized vectors)."""
+
+    if not left or not right or len(left) != len(right):
+        return 0.0
+    norm_left = math.sqrt(sum(value * value for value in left))
+    norm_right = math.sqrt(sum(value * value for value in right))
+    if norm_left <= 0.0 or norm_right <= 0.0:
+        return 0.0
+    dot = sum(a * b for a, b in zip(left, right))
+    return max(0.0, min(1.0, dot / (norm_left * norm_right)))
