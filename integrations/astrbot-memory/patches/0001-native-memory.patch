index 0000000..70ac101
--- /dev/null
+++ b/astrbot/core/memory/policy.py
@@ -0,0 +1,346 @@
+"""Per-group long-term memory policy (which chats are allowed to remember).
+
+Config contract (``memory.policy``, see CONTRACT.md §5)::
+
+    {
+      "default_mode": "conversation",
+      "private": {"mode": "long_term", "scope": "user", "extract": true,
+                  "inject": true, "max_items": 8, "max_chars": 1500},
+      "groups": {
+        "aiocqhttp:838796241": {"mode": "long_term", "scope": "group_user",
+                                "extract": true, "inject": true,
+                                "max_items": 8, "max_chars": 1500}
+      }
+    }
+
+Rules:
+
+* ``default_mode`` -- mode for chats that are not listed (private chats fall
+  back to ``private`` when given, else to ``default_mode``).
+* ``mode`` is required in every entry.  ``conversation`` = this chat never
+  reads or writes long-term memory (AstrBot's own conversation history is not
+  affected); ``long_term`` = read/write the scopes below.
+* ``scope`` -- ``group`` (this group only), ``user`` (the sender's personal
+  memory only; enabling it in a group is an explicit opt-in to use that
+  person's private memories there), ``group_user`` (read group + sender user,
+  write group).  Private chats only accept ``user``.
+* ``extract`` / ``inject`` are independent: write-only and read-only are valid.
+* ``max_items`` / ``max_chars`` are optional per-entry budgets; when absent the
+  service-wide ``memory.max_items`` / ``memory.max_chars`` apply.
+
+Anything invalid (unknown mode/scope, non-boolean flags, out-of-range budgets,
+a listing that is not an object) degrades that entry -- or the whole policy
+when ``default_mode`` is bad -- to ``conversation``.  Failing safe means "stop
+remembering", never "remember more".
+
+The identity used for the lookup comes from the event's group id (platform
+prefixed) or its UMO, never from message text.  Parsed tables are cached by
+config fingerprint with a short TTL so policy edits take effect without a
+restart: a changed config produces a new fingerprint, hence a re-parse.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+import threading
+import time
+from collections.abc import Mapping
+from dataclasses import dataclass
+
+logger = logging.LoggerAdapter(
+    logging.getLogger("astrbot.memory"),
+    {
+        "plugin_tag": "[astrbot_memory]",
+        # AstrBot's formatter expects these fields; records from the memory
+        # package do not pass through its normal plugin logger filter.
+        "short_levelname": "INFO",
+        "astrbot_version_tag": "",
+    },
+)
+
+MODE_CONVERSATION = "conversation"
+MODE_LONG_TERM = "long_term"
+MODES = (MODE_CONVERSATION, MODE_LONG_TERM)
+
+SCOPE_GROUP = "group"
+SCOPE_USER = "user"
+SCOPE_GROUP_USER = "group_user"
+SCOPE_GROUP_MEMBER = "group_member"
+"""Speaker rows inside one group; stores the sender id next to the fact.
+
+It is a separate scope on purpose: ``group_user`` keeps its documented
+single-write semantics (read group+sender, write the group), while
+``group_member`` reads *and* writes only that speaker's rows in that group.
+"""
+
+ALLOWED_SCOPES = (SCOPE_GROUP, SCOPE_USER, SCOPE_GROUP_USER, SCOPE_GROUP_MEMBER)
+
+DEFAULT_MAX_ITEMS_MIN, DEFAULT_MAX_ITEMS_MAX = 1, 50
+DEFAULT_MAX_CHARS_MIN, DEFAULT_MAX_CHARS_MAX = 80, 8000
+
+POLICY_TTL_SECONDS = 5.0
+"""Parsed-policy cache TTL.  A config edit invalidates it immediately (the
+fingerprint changes); the TTL only bounds how long an unchanged entry lives.
+"""
+
+_CACHE_MAX_ENTRIES = 8
+
+
+@dataclass(frozen=True)
+class MemoryPolicy:
+    """Resolved policy for one chat turn."""
+
+    mode: str = MODE_CONVERSATION
+    scope: str = SCOPE_GROUP
+    extract: bool = True
+    inject: bool = True
+    max_items: int | None = None
+    max_chars: int | None = None
+    source: str = "default"
+    error: str = ""
+
+    @property
+    def long_term(self) -> bool:
+        return self.mode == MODE_LONG_TERM
+
+    @property
+    def inactive(self) -> bool:
+        return not self.long_term
+
+    def as_dict(self) -> dict:
+        return {
+            "mode": self.mode,
+            "scope": self.scope,
+            "extract": self.extract,
+            "inject": self.inject,
+            "max_items": self.max_items,
+            "max_chars": self.max_chars,
+            "source": self.source,
+            "error": self.error,
+        }
+
+
+@dataclass(frozen=True)
+class PolicyTable:
+    """A parsed ``memory.policy`` section (all entries + defaults)."""
+
+    default_mode: str = MODE_CONVERSATION
+    private: MemoryPolicy | None = None
+    groups: Mapping[str, MemoryPolicy] | None = None
+    errors: tuple[str, ...] = ()
+
+    def entry_for(
+        self,
+        *,
+        platform: str = "",
+        group_id: str = "",
+        is_private: bool = True,
+    ) -> MemoryPolicy:
+        group_id = str(group_id or "").strip()
+        platform = str(platform or "").strip()
+        if is_private or not group_id:
+            if self.private is not None:
+                return self.private
+            return _default_policy(self.default_mode, is_private=True, errors=self.errors)
+        groups = self.groups or {}
+        for key in (group_policy_key(platform, group_id), group_id):
+            entry = groups.get(key)
+            if entry is not None:
+                return entry
+        return _default_policy(self.default_mode, is_private=False, errors=self.errors)
+
+
+class PolicyResolver:
+    """Cache parsed policy tables by config fingerprint (TTL + invalidation)."""
+
+    def __init__(self, ttl: float = POLICY_TTL_SECONDS, clock=time.monotonic) -> None:
+        self.ttl = max(0.0, float(ttl))
+        self.clock = clock
+        self._cache: dict[str, tuple[float, PolicyTable]] = {}
+        self._lock = threading.Lock()
+        self.parses = 0
+
+    def table(self, section) -> PolicyTable:
+        fingerprint = section_fingerprint(section)
+        now = self.clock()
+        with self._lock:
+            hit = self._cache.get(fingerprint)
+            if hit is not None and hit[0] > now:
+                return hit[1]
+        table = parse_policy(section)
+        with self._lock:
+            self._cache[fingerprint] = (now + self.ttl, table)
+            self._trim()
+        self.parses += 1
+        if table.errors:
+            logger.warning("长期记忆策略配置有 %d 处非法项（已按 conversation 处理）：%s", len(table.errors), "; ".join(table.errors))
+        return table
+
+    def resolve(
+        self,
+        section,
+        *,
+        platform: str = "",
+        group_id: str = "",
+        is_private: bool = True,
+    ) -> MemoryPolicy:
+        return self.table(section).entry_for(platform=platform, group_id=group_id, is_private=is_private)
+
+    def invalidate(self) -> None:
+        with self._lock:
+            self._cache.clear()
+
+    def _trim(self) -> None:
+        """Keep the cache small: drop the entries closest to expiry."""
+        if len(self._cache) <= _CACHE_MAX_ENTRIES:
+            return
+        ordered = sorted(self._cache.items(), key=lambda item: item[1][0])
+        for fingerprint, _ in ordered[: len(self._cache) - _CACHE_MAX_ENTRIES]:
+            self._cache.pop(fingerprint, None)
+
+
+def group_policy_key(platform: str, group_id: str) -> str:
+    """Platform-prefixed group identity, e.g. ``aiocqhttp:838796241``."""
+
+    platform = str(platform or "").strip()
+    group_id = str(group_id or "").strip()
+    return f"{platform}:{group_id}" if platform else group_id
+
+
+def section_fingerprint(section) -> str:
+    """Stable fingerprint of a policy section (cache key + change detection)."""
+
+    try:
+        payload = json.dumps(section, sort_keys=True, ensure_ascii=False, default=str)
+    except Exception:  # noqa: BLE001 - exotic mapping/config type
+        try:
+            payload = repr(section)
+        except Exception:  # noqa: BLE001 - give up, force a re-parse each call
+            payload = ""
+    return hashlib.sha1(payload.encode("utf-8", "replace")).hexdigest()
+
+
+def parse_policy(section) -> PolicyTable:
+    """Validate an arbitrary ``memory.policy`` value into a ``PolicyTable``."""
+
+    errors: list[str] = []
+    if section is None:
+        return PolicyTable()
+    if not isinstance(section, Mapping):
+        return PolicyTable(errors=("policy 不是对象（已按 conversation 处理）",))
+
+    raw_default = section.get("default_mode", MODE_CONVERSATION)
+    default_mode = _normalise_mode(raw_default)
+    if default_mode is None:
+        errors.append(f"default_mode 非法：{raw_default!r}（已按 conversation 处理）")
+        default_mode = MODE_CONVERSATION
+
+    private: MemoryPolicy | None = None
+    raw_private = section.get("private")
+    if raw_private:
+        try:
+            private = _parse_entry(raw_private, is_private=True, source="private")
+        except _Invalid as exc:
+            errors.append(f"private: {exc}")
+            private = MemoryPolicy(MODE_CONVERSATION, SCOPE_USER, source="private", error=str(exc))
+
+    groups: dict[str, MemoryPolicy] = {}
+    raw_groups = section.get("groups")
+    if raw_groups is not None and not isinstance(raw_groups, Mapping):
+        errors.append("groups 不是对象（所有群按 default_mode 处理）")
+    elif isinstance(raw_groups, Mapping):
+        for key, raw in raw_groups.items():
+            if not isinstance(key, str) or not key.strip():
+                errors.append(f"groups 的键非法：{key!r}")
+                continue
+            name = key.strip()
+            try:
+                groups[name] = _parse_entry(raw, is_private=False, source=f"groups:{name}")
+            except _Invalid as exc:
+                errors.append(f"groups:{name}: {exc}")
+                groups[name] = MemoryPolicy(MODE_CONVERSATION, SCOPE_GROUP, source=f"groups:{name}", error=str(exc))
+
+    return PolicyTable(default_mode=default_mode, private=private, groups=groups, errors=tuple(errors))
+
+
+class _Invalid(ValueError):
+    """A policy entry failed validation; the caller degrades it to conversation."""
+
+
+def _normalise_mode(value) -> str | None:
+    if not isinstance(value, str):
+        return None
+    mode = value.strip().lower()
+    return mode if mode in MODES else None
+
+
+def _parse_entry(raw, *, is_private: bool, source: str) -> MemoryPolicy:
+    if not isinstance(raw, Mapping):
+        raise _Invalid("策略条目必须是对象")
+    mode = _normalise_mode(raw.get("mode"))
+    if mode is None:
+        raise _Invalid(f"mode 必须是 {MODES} 之一，收到 {raw.get('mode')!r}")
+
+    raw_scope = raw.get("scope")
+    if raw_scope is None:
+        scope = SCOPE_USER if is_private else SCOPE_GROUP
+    else:
+        scope = raw_scope.strip().lower() if isinstance(raw_scope, str) else None
+        if scope not in ALLOWED_SCOPES:
+            raise _Invalid(f"scope 必须是 {ALLOWED_SCOPES} 之一，收到 {raw_scope!r}")
+    if is_private and scope != SCOPE_USER:
+        raise _Invalid("私聊只支持 scope=user（group_member/group_user 只在群里可用）")
+
+    return MemoryPolicy(
+        mode=mode,
+        scope=scope,
+        extract=_require_bool(raw, "extract", True),
+        inject=_require_bool(raw, "inject", True),
+        max_items=_require_int(raw, "max_items", DEFAULT_MAX_ITEMS_MIN, DEFAULT_MAX_ITEMS_MAX),
+        max_chars=_require_int(raw, "max_chars", DEFAULT_MAX_CHARS_MIN, DEFAULT_MAX_CHARS_MAX),
+        source=source,
+    )
+
+
+def _require_bool(raw: Mapping, name: str, default: bool) -> bool:
+    if name not in raw or raw[name] is None:
+        return default
+    value = raw[name]
+    if not isinstance(value, bool):
+        raise _Invalid(f"{name} 必须是 true/false，收到 {value!r}")
+    return value
+
+
+def _require_int(raw: Mapping, name: str, low: int, high: int) -> int | None:
+    if name not in raw or raw[name] is None:
+        return None
+    value = raw[name]
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise _Invalid(f"{name} 必须是整数，收到 {value!r}")
+    if not low <= value <= high:
+        raise _Invalid(f"{name} 必须在 {low}..{high} 之间，收到 {value}")
+    return value
+
+
+def _default_policy(mode: str, *, is_private: bool, errors: tuple[str, ...] = ()) -> MemoryPolicy:
+    # Config errors that shaped the default (bad default_mode, unparsable
+    # section) travel with the resolved default so callers can see why a chat
+    # fell back to conversation.
+    return MemoryPolicy(
+        mode=mode,
+        scope=SCOPE_USER if is_private else SCOPE_GROUP,
+        source="private-default" if is_private else "default",
+        error="; ".join(errors),
+    )
+
+
+__all__ = [
+    "ALLOWED_SCOPES",
+    "MODE_CONVERSATION",
+    "MODE_LONG_TERM",
+    "MODES",
+    "MemoryPolicy",
+    "POLICY_TTL_SECONDS",
+    "PolicyResolver",
+    "PolicyTable",
+    "SCOPE_GROUP",
+    "SCOPE_GROUP_MEMBER",
+    "SCOPE_GROUP_USER",
+    "SCOPE_USER",
+    "group_policy_key",
+    "parse_policy",
+    "section_fingerprint",
+]
diff --git a/astrbot/core/memory/reflect.py b/astrbot/core/memory/reflect.py
new file mode 100644
index 0000000..41647ec
--- /dev/null
+++ b/astrbot/core/memory/reflect.py
@@ -0,0 +1,309 @@
+"""Deterministic memory reflection: preview first, apply only what is safe.
+
+Reflection is a maintenance pass over **one explicit scope at a time**:
+
+* near-duplicates (token Jaccard >= ``similarity``) are reported with the row
+  that would be kept, and merged only on ``apply``;
+* contradictions (polarity flip + high similarity) are *reported only* -- a
+  negative preference is not silently deleted because two rows disagree;
+* low-value rows (importance/hits below the preview thresholds) are listed,
+  never deleted automatically;
+* expired rows are listed and purged on ``apply`` (they are already dead);
+* ``apply`` copies the SQLite file first, so every change can be rolled back
+  by restoring the backup.
+
+No model call, no network, no LLM: the pass is explainable and repeatable.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterable, Mapping
+from dataclasses import dataclass
+from pathlib import Path
+
+from .text import is_contradiction, similarity
+from .types import SCOPE_TYPES, MemoryRecord
+
+DEFAULT_SIMILARITY = 0.86
+"""Token Jaccard at/above which two rows in one scope are near-duplicates."""
+
+DEFAULT_CONTRADICTION_SIMILARITY = 0.6
+"""Two rows must overlap this much before a polarity flip is a contradiction."""
+
+DEFAULT_LOW_VALUE_IMPORTANCE = 0.35
+DEFAULT_LOW_VALUE_HITS = 0
+MAX_SCAN_PER_SCOPE = 500
+MAX_CONTRADICTION_PAIRS = 100
+
+
+@dataclass(frozen=True)
+class ReflectSettings:
+    """Operator knobs for one reflection pass (all local, all explainable)."""
+
+    similarity: float = DEFAULT_SIMILARITY
+    contradiction_similarity: float = DEFAULT_CONTRADICTION_SIMILARITY
+    low_value_importance: float = DEFAULT_LOW_VALUE_IMPORTANCE
+    low_value_hits: int = DEFAULT_LOW_VALUE_HITS
+    backup: bool = True
+    max_scan: int = MAX_SCAN_PER_SCOPE
+
+    @classmethod
+    def from_mapping(cls, mapping) -> "ReflectSettings":
+        raw = mapping if isinstance(mapping, Mapping) else {}
+
+        def _float(name: str, default: float, low: float, high: float) -> float:
+            value = raw.get(name)
+            if isinstance(value, bool) or not isinstance(value, (int, float)):
+                return default
+            return min(high, max(low, float(value)))
+
+        def _int(name: str, default: int, low: int, high: int) -> int:
+            value = raw.get(name)
+            if isinstance(value, bool) or not isinstance(value, int):
+                return default
+            return min(high, max(low, value))
+
+        backup = raw.get("backup")
+        return cls(
+            similarity=_float("similarity", DEFAULT_SIMILARITY, 0.5, 1.0),
+            contradiction_similarity=_float(
+                "contradiction_similarity", DEFAULT_CONTRADICTION_SIMILARITY, 0.3, 1.0
+            ),
+            low_value_importance=_float(
+                "low_value_importance", DEFAULT_LOW_VALUE_IMPORTANCE, 0.0, 1.0
+            ),
+            low_value_hits=_int("low_value_hits", DEFAULT_LOW_VALUE_HITS, 0, 1_000_000),
+            backup=backup if isinstance(backup, bool) else True,
+            max_scan=_int("max_scan", MAX_SCAN_PER_SCOPE, 20, 5_000),
+        )
+
+    def as_dict(self) -> dict:
+        return {
+            "similarity": self.similarity,
+            "contradiction_similarity": self.contradiction_similarity,
+            "low_value_importance": self.low_value_importance,
+            "low_value_hits": self.low_value_hits,
+            "backup": self.backup,
+            "max_scan": self.max_scan,
+        }
+
+
+def normalise_scopes(scopes: Iterable[tuple[str, str]] | None) -> list[tuple[str, str]]:
+    """Validate an explicit scope allow-list (never a wildcard)."""
+
+    ordered: list[tuple[str, str]] = []
+    for scope in scopes or ():
+        scope_type, scope_id = (str(scope[0] or ""), str(scope[1] or ""))
+        if scope_type not in SCOPE_TYPES or not scope_id:
+            raise ValueError(f"反射需要显式合法作用域，收到 {scope!r}")
+        if (scope_type, scope_id) not in ordered:
+            ordered.append((scope_type, scope_id))
+    if not ordered:
+        raise ValueError("反射需要至少一个显式作用域")
+    return ordered
+
+
+def _quality(record: MemoryRecord) -> tuple:
+    # Highest importance/confidence/hits, then newest, then lowest id wins:
+    # stable across repeated runs (no dependence on dict/SQL order).
+    return (-record.importance, -record.confidence, -record.hits, -record.updated_at, record.id)
+
+
+def _row(record: MemoryRecord) -> dict:
+    return {
+        "id": record.id,
+        "key": record.key,
+        "content": record.content,
+        "importance": record.importance,
+        "confidence": record.confidence,
+        "hits": record.hits,
+        "sender_id": record.sender_id,
+        "updated_at": record.updated_at,
+        "expires_at": record.expires_at,
+    }
+
+
+def build_plan(
+    store,
+    scopes: Iterable[tuple[str, str]],
+    *,
+    settings: ReflectSettings | None = None,
+    now: float | None = None,
+) -> dict:
+    """Build the dry-run report for ``scopes`` (read-only, deterministic)."""
+
+    settings = settings or ReflectSettings()
+    current = float(now if now is not None else store.clock())
+    scope_list = normalise_scopes(scopes)
+    plan: dict = {
+        "ok": True,
+        "dry_run": True,
+        "generated_at": current,
+        "settings": settings.as_dict(),
+        "scopes": [{"scope_type": scope_type, "scope_id": scope_id} for scope_type, scope_id in scope_list],
+        "duplicates": [],
+        "contradictions": [],
+        "low_value": [],
+        "expired": [],
+        "counts": {
+            "scopes": len(scope_list),
+            "records": 0,
+            "duplicate_groups": 0,
+            "duplicate_rows": 0,
+            "contradictions": 0,
+            "low_value": 0,
+            "expired": 0,
+        },
+        "applied": False,
+        "merged": 0,
+        "purged": 0,
+        "backup_path": "",
+        "errors": [],
+    }
+
+    for scope_type, scope_id in scope_list:
+        records = store.list_scope(scope_type, scope_id, limit=settings.max_scan)
+        plan["counts"]["records"] += len(records)
+        ordered = sorted(records, key=_quality)
+        assigned: set[int] = set()
+        for index, keeper in enumerate(ordered):
+            if keeper.id in assigned:
+                continue
+            group = [
+                other
+                for other in ordered[index + 1 :]
+                if other.id not in assigned
+                and similarity(keeper.content, other.content) >= settings.similarity
+            ]
+            if not group:
+                continue
+            for other in group:
+                assigned.add(other.id)
+            group_scores = [similarity(keeper.content, other.content) for other in group]
+            plan["duplicates"].append(
+                {
+                    "scope_type": scope_type,
+                    "scope_id": scope_id,
+                    "keep": _row(keeper),
+                    "merge": [_row(other) for other in group],
+                    "similarity": round(min(group_scores), 4),
+                }
+            )
+
+        merged_ids = {
+            int(row["id"]) for item in plan["duplicates"] for row in item["merge"]
+        }
+        # Contradictions: same topic (high overlap) but opposite polarity.
+        # Only surviving rows are paired: a duplicate that is merged away next
+        # would otherwise report the same conflict twice.
+        survivors = [record for record in ordered if record.id not in merged_ids]
+        # ponytail: O(n^2) inside one scope (<= max_scan rows, operator-only
+        # path); swap for an inverted index if scopes ever hold >5k rows.
+        reported = 0
+        for left_index, left in enumerate(survivors):
+            if reported >= MAX_CONTRADICTION_PAIRS:
+                break
+            for right in survivors[left_index + 1 :]:
+                if reported >= MAX_CONTRADICTION_PAIRS:
+                    break
+                if similarity(left.content, right.content) < settings.contradiction_similarity:
+                    continue
+                if not is_contradiction(left.content, right.content):
+                    continue
+                plan["contradictions"].append(
+                    {
+                        "scope_type": scope_type,
+                        "scope_id": scope_id,
+                        "a": _row(left),
+                        "b": _row(right),
+                        "reason": "polarity",
+                        "action": "report-only",
+                    }
+                )
+                reported += 1
+
+        for record in records:
+            if record.id in merged_ids:
+                # Already handled by the merge above; don't double-report it.
+                continue
+            if record.expires_at is not None and record.expires_at <= current:
+                plan["expired"].append(
+                    {"scope_type": scope_type, "scope_id": scope_id, "record": _row(record)}
+                )
+                continue
+            if (
+                record.importance < settings.low_value_importance
+                and record.hits <= settings.low_value_hits
+            ):
+                plan["low_value"].append(
+                    {"scope_type": scope_type, "scope_id": scope_id, "record": _row(record)}
+                )
+
+    plan["counts"].update(
+        {
+            "duplicate_groups": len(plan["duplicates"]),
+            "duplicate_rows": sum(len(item["merge"]) for item in plan["duplicates"]),
+            "contradictions": len(plan["contradictions"]),
+            "low_value": len(plan["low_value"]),
+            "expired": len(plan["expired"]),
+        }
+    )
+    return plan
+
+
+def apply_plan(
+    store,
+    plan: dict,
+    *,
+    settings: ReflectSettings | None = None,
+    backup_dir: str | Path | None = None,
+    now: float | None = None,
+) -> dict:
+    """Apply a plan: backup first, then merge duplicates and purge expired rows.
+
+    Contradictions and low-value rows are *reported only* -- they stay in the
+    DB because only a human (or a later explicit delete) may drop them.
+    """
+
+    settings = settings or ReflectSettings()
+    if not plan.get("ok"):
+        return plan
+    current = float(now if now is not None else plan.get("generated_at") or store.clock())
+    result = dict(plan)
+    result["dry_run"] = False
+    result["errors"] = list(plan.get("errors") or [])
+
+    if settings.backup:
+        try:
+            destination = None
+            if backup_dir:
+                destination = Path(backup_dir) / f"astrbot_memory.reflect.{int(current)}.db"
+            result["backup_path"] = store.backup(destination)
+        except Exception as exc:  # noqa: BLE001 - no backup, no apply
+            result["ok"] = False
+            result["applied"] = False
+            result["errors"].append(f"备份失败，已放弃写入：{type(exc).__name__}")
+            return result
+
+    merged = 0
+    for item in plan.get("duplicates") or ():
+        keep_id = int(item["keep"]["id"])
+        drop_ids = [int(row["id"]) for row in item.get("merge") or ()]
+        try:
+            if store.merge_records(keep_id, drop_ids) is not None:
+                merged += len(drop_ids)
+        except Exception as exc:  # noqa: BLE001 - one failed merge must not stop the pass
+            result["errors"].append(f"合并 {keep_id} 失败：{type(exc).__name__}")
+    purged = 0
+    for item in plan.get("expired") or ():
+        memory_id = int(item["record"]["id"])
+        try:
+            if store.delete(memory_id):
+                purged += 1
+        except Exception as exc:  # noqa: BLE001 - keep going
+            result["errors"].append(f"删除过期 {memory_id} 失败：{type(exc).__name__}")
+
+    result["applied"] = True
+    result["merged"] = merged
+    result["purged"] = purged
+    return result
