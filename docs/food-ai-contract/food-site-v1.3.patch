+LOCATION_PATH_CTE = """
+    WITH RECURSIVE loc_path(id, name, parent_id, path, depth) AS (
+        SELECT id, name, parent_id, name, 0 FROM locations WHERE parent_id IS NULL
+        UNION ALL
+        SELECT l.id, l.name, l.parent_id, p.path || '/' || l.name, p.depth + 1
+        FROM locations l JOIN loc_path p ON l.parent_id = p.id
+        WHERE p.depth < 64
+    )
+"""
+
+# 位置搜索的分隔符：/ \ - — – > → ／ ＼ 以及空白
+LOCATION_QUERY_SEP_PATTERN = re.compile(r'[/\\\-—–>→／＼\s]+')
+
+
+def _like_escape(term):
+    return term.replace('\\', '\\\\').replace('%', '\\%').replace('_', '\\_')
+
+
+def search_location_paths(q, limit=20):
+    """按全路径搜索位置（递归 CTE 现算 full_path，无 schema 迁移、无物化列）。
+
+    命中任一形式即可：
+      - 连续全路径：长春市朝阳区 / 中国吉林省长春市朝阳区（去 / 后包含匹配）
+      - 单级名称：朝阳区
+      - 多段分量：吉林省/长春市、长春市 朝阳区（每段都需在路径中）
+    返回按「完全相等优先 → 路径短优先」排序的行（id/name/path）。
+    """
+    terms = [t for t in LOCATION_QUERY_SEP_PATTERN.split(q or '') if t]
+    if not terms:
+        return []
+    clauses = []
+    params = {}
+    for i, term in enumerate(terms[:6]):
+        key = 't%d' % i
+        params[key] = '%' + _like_escape(term) + '%'
+        clauses.append(
+            "(path LIKE :{k} ESCAPE '\\' OR REPLACE(path, '/', '') LIKE :{k} ESCAPE '\\')".format(k=key)
+        )
+    params['exact'] = ''.join(terms)
+    params['limit'] = limit
+    sql = (
+        LOCATION_PATH_CTE
+        + ' SELECT id, name, path FROM loc_path WHERE ' + ' AND '.join(clauses)
+        + " ORDER BY (REPLACE(path, '/', '') = :exact) DESC, LENGTH(path), id LIMIT :limit"
+    )
+    return db.session.execute(text(sql), params).fetchall()
+
+
+def matching_location_ids(q):
+    """位置全路径命中的位置及其所有后代 ID（按位置搜饭店用）。"""
+    matched = [row.id for row in search_location_paths(q, limit=200)]
+    ids = set(matched)
+    for loc_id in matched:
+        ids.update(get_all_sub_location_ids(loc_id))
+    return sorted(ids)
+
