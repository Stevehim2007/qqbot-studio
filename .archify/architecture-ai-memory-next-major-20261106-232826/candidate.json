  "cards": [
    {
      "dot": "cyan",
      "title": "请求主链",
      "items": [
        "qqbot_core_reply 是唯一聊天控制器，负责接收消息、决定是否回复并组织上下文",
        "qqbot_memory_commands 只处理 /记忆 命令和 scope 读写，不启动聊天模型",
        "会话与人格解析先确定群、用户、会话和 persona，再进入 Prompt 编排"
      ]
    },
    {
      "dot": "emerald",
      "title": "稳定前缀",
      "items": [
        "persona_core 常驻，style / lore / rules 按需注入，完整人格不默认全量拼入",
        "Persona Cache 以 persona_id + revision + platform + bot_id 为键，人格未变时前缀字节级稳定",
        "前缀中禁止时间戳、随机数和实时状态；provider prompt cache 负责复用"
      ]
    },
    {
      "dot": "violet",
      "title": "SurfCore 分层记忆",
      "items": [
        "Active Cards 承载当前工作记忆，Archive Cards 承载长期记忆，Hybrid Index 提供 BM25 + vector 召回",
        "Memory Retrieval 按 scope 检索并 rerank，Context Budget 对条数和 token 设硬预算",
        "Consolidation Worker 负责抽取、合并、晋升、衰减和索引重建"
      ]
    },
    {
      "dot": "amber",
      "title": "运行与反馈",
      "items": [
        "回复后由 core_reply 将对话、抽取结果和记忆写回 SurfCore，不覆盖其他 scope",
        "Studio 管理 memory-policy、记忆记录和导入导出；短期会话仍由 AstrBot 原生上下文承接",
        "观测 persona_cache_hit/miss、rendered_persona_chars、prompt_prefix_chars、retrieved_memory_items 和 estimated_input_tokens"
      ]
    }
  ]
