{
  "config_version": 5,
  "timezone": "Asia/Shanghai",
  "wake_prefix": ["/"],
  "dashboard": {
    "enable": true,
    "username": "admin",
    "password": "<MD5_OF_RAW_PASSWORD>",
    "pbkdf2_password": "pbkdf2_sha256$600000$<SALT_HEX>$<DIGEST_HEX>",
    "password_storage_upgraded": true,
    "password_change_required": false,
    "jwt_secret": "<RANDOM_HEX_SECRET>",
    "host": "0.0.0.0",
    "port": 6185
  },
  "provider": [
    {
      "id": "deepseek-flash",
      "provider": "deepseek",
      "type": "openai_chat_completion",
      "provider_type": "chat_completion",
      "enable": true,
      "key": ["<DEEPSEEK_API_KEY>"],
      "api_base": "https://api.deepseek.com/v1",
      "model": "deepseek-flash",
      "timeout": 120,
      "proxy": "",
      "custom_headers": {}
    }
  ],
  "provider_settings": {
    "enable": true,
    "provider_pool": ["*"],
    "persona_pool": ["*"],
    "datetime_system_prompt": true,
    "prompt_prefix": "{{prompt}}"
  },
  "agent_runner": {
    "runner_type": "local",
    "config": {
      "model": {
        "provider_id": "deepseek-flash",
        "fallback_provider_ids": [],
        "request_max_retries": 5
      },
      "persona": {
        "persona_id": "qqbot-assistant",
        "safety_mode": true,
        "safety_mode_strategy": "system_prompt"
      }
    }
  },
  "platform": [
    {
      "id": "qqbot-onebot",
      "type": "aiocqhttp",
      "enable": true,
      "ws_reverse_host": "0.0.0.0",
      "ws_reverse_port": 6199,
      "ws_reverse_token": "<ONE_BOT_TOKEN>"
    }
  ],
  "platform_settings": {
    "enable_id_white_list": false,
    "id_whitelist": [],
    "empty_mention_waiting": true
  },
  "plugin_set": ["*"]
}
