{
  "networks": {
    "httpServers": [
      {
        "name": "http-default",
        "enabled": false,
        "host": "127.0.0.1",
        "port": 3000,
        "path": "/",
        "accessToken": "<SNOWLUMA_HTTP_TOKEN>",
        "messageFormat": "array",
        "reportSelfMessage": false
      }
    ],
    "httpClients": [],
    "wsServers": [
      {
        "name": "ws-default",
        "enabled": false,
        "host": "127.0.0.1",
        "port": 3001,
        "path": "/",
        "role": "Universal",
        "accessToken": "<SNOWLUMA_WS_TOKEN>",
        "messageFormat": "array",
        "reportSelfMessage": false
      }
    ],
    "wsClients": [
      {
        "name": "astrbot",
        "enabled": true,
        "url": "ws://astrbot:6199/ws",
        "role": "Universal",
        "accessToken": "<ONE_BOT_TOKEN>",
        "messageFormat": "array",
        "reportSelfMessage": false,
        "reconnectIntervalMs": 5000
      }
    ]
  },
  "statusCommand": {
    "enabled": true,
    "swallow": false,
    "cooldownSeconds": 5,
    "trigger": "#sl"
  },
  "historySync": {
    "enabled": false
  },
  "notifications": {
    "channelIds": []
  }
}
